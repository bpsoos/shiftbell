package schedules

import viewicons "github.com/bpsoos/shiftbell/internal/view/icons"

templ schedulePanel(backHref string, backLabel string, headingID string, heading string) {
	<section aria-labelledby={ headingID }>
		<style>
			me {
				margin-inline: auto;
				max-width: 42rem;
			}
			me > a {
				align-items: center;
				color: var(--sb-muted);
				display: inline-flex;
				font-size: 0.875rem;
				gap: 0.375rem;
				margin-bottom: 1.125rem;
				text-decoration: none;
			}
			me > a:hover {
				color: var(--sb-text);
			}
		</style>
		<a data-back href={ backHref } hx-get={ backHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
			@viewicons.ArrowLeft()
			<span>{ backLabel }</span>
		</a>
		<div>
			<style>
				me {
					background: var(--sb-surface);
					border: 2px solid var(--sb-frame);
				}
			</style>
			<header>
				<style>
					me {
						background: var(--sb-subtle);
						border-bottom: 1px solid var(--sb-border);
						border-left: 3px solid var(--sb-accent);
						padding: 0.875rem 1.125rem;
					}
					me > h1 {
						font-size: 1.25rem;
						letter-spacing: -0.02em;
						margin: 0;
					}
				</style>
				<h1 id={ headingID }>{ heading }</h1>
			</header>
			<div>
				<style>
					me {
						padding: 1.125rem;
					}
					me > [data-help] {
						color: var(--sb-muted);
						font-size: 0.875rem;
						margin: 0 0 1rem;
					}
					@media sm- {
						me {
							padding: 0.875rem;
						}
					}
				</style>
				{ children... }
			</div>
		</div>
	</section>
}

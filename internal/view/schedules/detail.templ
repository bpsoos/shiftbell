package schedules

import (
	"strconv"
	"time"

	apimodels "github.com/bpsoos/shiftbell/internal/models/api/schedules"
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/schedules"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ detail(model viewmodels.Detail) {
	<section aria-labelledby="schedule-heading">
		<style>
			me {
				margin-inline: auto;
				max-width: 42rem;
			}
			me > [data-notice] {
				background: var(--sb-surface);
				border: 1px solid var(--sb-border);
				border-left: 3px solid var(--sb-accent);
				font-size: 0.875rem;
				margin-bottom: 0.875rem;
				padding: 0.625rem 0.75rem;
			}
		</style>
		if model.Notice != "" {
			<p data-notice role="status">{ model.Notice }</p>
		}
		@scheduleCard(model.Schedule)
	</section>
}

templ scheduleCard(schedule apimodels.Representation) {
	<article data-schedule-detail>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				box-shadow: inset 0 3px 0 var(--sb-accent);
				overflow-wrap: anywhere;
				padding: 1.5rem 1.25rem 1.25rem;
			}
			@media sm- {
				me {
					padding: 1.25rem 1rem 1rem;
				}
			}
		</style>
		@scheduleHeader(schedule)
		@scheduleProperties(schedule)
		@currentChore(schedule)
	</article>
}

templ scheduleHeader(schedule apimodels.Representation) {
	<header>
		<style>
			me > [data-eyebrow] {
				color: var(--sb-muted);
				font-size: 0.6875rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				margin: 0 0 0.5rem;
				text-transform: uppercase;
			}
			me > [data-heading] {
				align-items: flex-start;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem 1rem;
				justify-content: space-between;
			}
			me h1 {
				font-size: 1.875rem;
				letter-spacing: -0.035em;
				line-height: 1.1;
				margin: 0;
			}
			me [data-state] {
				border: 1px solid var(--sb-border);
				color: var(--sb-muted-strong);
				flex: 0 0 auto;
				font-size: 0.75rem;
				font-weight: 650;
				padding: 0.1875rem 0.5rem;
			}
			@media sm- {
				me h1 {
					font-size: 1.625rem;
				}
			}
		</style>
		<p data-eyebrow>Schedule</p>
		<div data-heading>
			<h1 id="schedule-heading">{ schedule.Name }</h1>
			if schedule.DeactivatedAt != nil {
				<span data-state="deactivated">Deactivated</span>
			}
		</div>
	</header>
}

templ scheduleProperties(schedule apimodels.Representation) {
	<dl>
		<style>
			me {
				margin: 1.5rem 0 0;
			}
			me > div {
				display: grid;
				gap: 0.375rem 1rem;
				grid-template-columns: 6.5rem minmax(0, 1fr);
				padding-block: 0.625rem;
			}
			me dt {
				color: var(--sb-muted);
				font-size: 0.875rem;
				font-weight: 500;
			}
			me dd {
				font-size: 0.9375rem;
				margin: 0;
			}
			me a {
				color: var(--sb-text);
				text-decoration-color: var(--sb-control-border);
				text-underline-offset: 0.2em;
			}
			me a:hover {
				text-decoration-color: var(--sb-accent);
			}
			@media sm- {
				me > div {
					grid-template-columns: 1fr;
				}
			}
		</style>
		<div>
			<dt>Template</dt>
			<dd>
				<a href={ schedule.Links.Href("chore_template") } hx-get={ schedule.Links.Href("chore_template") } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{ schedule.ChoreTemplateName }</a>
			</dd>
		</div>
		<div>
			<dt>Recurrence</dt>
			<dd>
				if schedule.IntervalDays == 1 {
					Every day
				} else {
					Every { strconv.Itoa(schedule.IntervalDays) } days
				}
			</dd>
		</div>
	</dl>
}

templ currentChore(schedule apimodels.Representation) {
	<div data-current-chore>
		<style>
			me {
				border-top: 1px solid var(--sb-border);
				margin-top: 1rem;
				padding-top: 1.125rem;
			}
			me > h2 {
				font-size: 0.9375rem;
				font-weight: 650;
				margin: 0 0 0.5rem;
			}
			me > p {
				color: var(--sb-muted);
				font-size: 0.875rem;
				margin: 0;
			}
			me > [data-deadline] {
				color: var(--sb-text);
			}
			me > [data-view-chore] {
				align-items: center;
				display: inline-flex;
				gap: 0.375rem;
				margin-top: 1rem;
			}
		</style>
		<h2>Current chore</h2>
		if href := schedule.Links.Href("active_chore"); href != "" {
			if schedule.ActiveChoreDeadline != nil {
				<p data-deadline>Due <time datetime={ schedule.ActiveChoreDeadline.Format(time.DateOnly) }>{ schedule.ActiveChoreDeadline.Format("Monday, 2 January 2006") }</time></p>
			}
			<a class="btn btn-outline-secondary" data-view-chore href={ href } hx-get={ href } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				<span>View chore</span>
				@viewicons.CaretRight()
			</a>
		} else {
			<p>No active chore.</p>
		}
	</div>
}

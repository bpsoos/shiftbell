package schedules

import (
	"time"

	apimodels "github.com/bpsoos/shiftbell/internal/models/api/schedules"
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/schedules"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
	"github.com/bpsoos/shiftbell/internal/view/resourcenavigation"
)

templ detail(t *Templater, model viewmodels.Detail) {
	<section aria-labelledby="schedule-heading">
		<style>
			me {
				margin-inline: auto;
				max-width: 42rem;
			}
			me > [data-back] {
				align-items: center;
				color: var(--sb-muted);
				display: inline-flex;
				font-size: 0.875rem;
				gap: 0.375rem;
				margin-bottom: 1.125rem;
				text-decoration: none;
			}
			me > [data-back]:hover,
			me > [data-back]:focus-visible {
				color: var(--sb-text);
			}
			me > [data-notice] {
				background: var(--sb-surface);
				border: 1px solid var(--sb-border);
				border-left: 3px solid var(--sb-accent);
				font-size: 0.875rem;
				margin-bottom: 0.875rem;
				padding: 0.625rem 0.75rem;
			}
		</style>
		if href := detailCollectionHref(model.Schedule); href != "" {
			<a data-back href={ href } hx-get={ href } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				@viewicons.ArrowLeft()
				<span>Schedules</span>
			</a>
		}
		if model.Notice != "" {
			<p data-notice role="status">{ model.Notice }</p>
		}
		@scheduleCard(t, model.Schedule)
	</section>
}

templ scheduleCard(t *Templater, schedule apimodels.Representation) {
	<article data-schedule-detail>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				box-shadow: inset 0 3px 0 var(--sb-accent);
				overflow-wrap: anywhere;
				padding: 1.5rem 1.25rem 1.25rem;
			}
			@media sm- {
				me {
					padding: 1.25rem 1rem 1rem;
				}
			}
		</style>
		@scheduleHeader(schedule)
		@scheduleProperties(t, schedule)
		@currentChore(schedule)
	</article>
}

templ scheduleHeader(schedule apimodels.Representation) {
	<header>
		<style>
			me > [data-heading] {
				align-items: flex-start;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem 1rem;
				justify-content: space-between;
			}
			me h1 {
				font-size: 1.875rem;
				letter-spacing: -0.035em;
				line-height: 1.1;
				margin: 0;
			}
			me [data-state] {
				border: 1px solid var(--sb-border);
				color: var(--sb-muted-strong);
				flex: 0 0 auto;
				font-size: 0.75rem;
				font-weight: 650;
				padding: 0.1875rem 0.5rem;
			}
			@media sm- {
				me h1 {
					font-size: 1.625rem;
				}
			}
		</style>
		<div data-heading>
			<h1 id="schedule-heading">{ schedule.Name }</h1>
			if schedule.DeactivatedAt != nil {
				<span data-state="deactivated">Deactivated</span>
			} else {
				@scheduleActions(schedule)
			}
		</div>
	</header>
}

templ scheduleProperties(t *Templater, schedule apimodels.Representation) {
	<dl>
		<style>
			me {
				margin: 1rem 0 0;
			}
			me > div {
				align-items: baseline;
				display: grid;
				gap: 0.375rem 1rem;
				grid-template-columns: 6.5rem minmax(0, 1fr);
				padding-block: 0.5rem;
			}
			me dt {
				color: var(--sb-muted);
				font-size: 0.75rem;
				font-weight: 400;
			}
			me dd {
				font-size: 0.9375rem;
				font-weight: 500;
				margin: 0;
			}
			me a {
				color: var(--sb-text);
				text-decoration-color: var(--sb-control-border);
				text-underline-offset: 0.2em;
			}
			me a:hover {
				text-decoration-color: var(--sb-accent);
			}
			@media sm- {
				me > div {
					grid-template-columns: 1fr;
				}
			}
		</style>
		<div>
			<dt>Template</dt>
			<dd>
				<a href={ schedule.Links.Href("chore_template") } hx-get={ schedule.Links.Href("chore_template") } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">{ schedule.ChoreTemplateName }</a>
			</dd>
		</div>
		<div>
			<dt>Recurrence</dt>
			<dd>
				{ intervalLabel(schedule.IntervalDays) }
			</dd>
		</div>
		if schedule.DeactivatedAt != nil {
			<div data-deactivated>
				<dt>Deactivated</dt>
				<dd><time datetime={ schedule.DeactivatedAt.Format(time.RFC3339) }>{ t.formatTime(*schedule.DeactivatedAt) }</time></dd>
			</div>
		}
	</dl>
}

templ currentChore(schedule apimodels.Representation) {
	<div data-current-chore>
		<style>
			me {
				border-top: 1px solid var(--sb-border);
				margin-top: 1.5rem;
				padding-top: 1.25rem;
			}
			me > h2 {
				font-size: 1.0625rem;
				font-weight: 700;
				margin: 0 0 0.625rem;
			}
			me > p {
				color: var(--sb-muted);
				font-size: 0.875rem;
				margin: 0;
			}
			me > [data-deadline] {
				color: var(--sb-text);
			}
			me > [data-view-chore] {
				margin-top: 0.125rem;
			}
		</style>
		<h2>Current chore</h2>
		if href := schedule.Links.Href("active_chore"); href != "" {
			if schedule.ActiveChoreDeadline != nil {
				<p data-deadline>Due <time datetime={ schedule.ActiveChoreDeadline.Format(time.DateOnly) }>{ schedule.ActiveChoreDeadline.Format("2006.01.02.") }</time></p>
			}
			<div data-view-chore>
				@resourcenavigation.Link(href, "View chore")
			</div>
		} else {
			<p>No active chore.</p>
		}
	</div>
}

package schedules

import (
	"time"

	api "github.com/bpsoos/shiftbell/internal/models/api"
	apimodels "github.com/bpsoos/shiftbell/internal/models/api/schedules"
	models "github.com/bpsoos/shiftbell/internal/models/schedules"
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/schedules"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ collection(model viewmodels.Collection) {
	<section aria-labelledby="schedules-heading" hx-sync="this:replace">
		<style>
			me {
				margin-block-start: -0.5rem;
				margin-inline: auto;
				max-width: 52rem;
			}
			@media xs- {
				me {
					margin-block-start: -0.75rem;
				}
			}
		</style>
		@collectionHeader(model.Filter)
		@collectionUtilities(model)
		if model.SearchOpen {
			@scheduleSearch(model)
		}
		if len(model.Collection.Items) == 0 {
			@collectionEmptyState(model)
		} else {
			@scheduleList(model.Collection.Items)
		}
		@collectionPagination(model.Collection.Links)
	</section>
}

templ collectionHeader(filter models.ScheduleFilter) {
	<header>
		<style>
			me {
				margin-bottom: 0.75rem;
			}
			me > h1 {
				font-size: 1.875rem;
				letter-spacing: -0.035em;
				line-height: 1;
				margin: 0;
			}
			me > h1::after {
				background: var(--sb-accent);
				content: "";
				display: block;
				height: 3px;
				margin-top: 0.5rem;
				width: 2rem;
			}
			@media sm- {
				me > h1 {
					font-size: 1.625rem;
				}
			}
		</style>
		<h1 id="schedules-heading">
			if filter == models.ScheduleFilterDeactivated {
				Deactivated schedules
			} else {
				Schedules
			}
		</h1>
	</header>
}

templ collectionEmptyState(model viewmodels.Collection) {
	<div data-empty-schedules>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				padding: 2rem 1rem;
				text-align: center;
			}
			me > h2 {
				font-size: 1rem;
				margin-bottom: 0.25rem;
			}
			me > p {
				color: var(--sb-muted);
				font-size: 0.875rem;
				margin: 0;
			}
		</style>
		if model.Search != "" {
			<h2>No matching schedules</h2>
			<p>Try a different search.</p>
		} else if model.Filter == models.ScheduleFilterDeactivated {
			<h2>No deactivated schedules</h2>
			<p>Permanently deactivated schedules will appear here.</p>
		} else {
			<h2>No schedules yet</h2>
			<p>Active schedules will appear here.</p>
		}
	</div>
}

templ scheduleList(items []apimodels.Response) {
	<ul data-schedule-list>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				list-style: none;
				margin: 0;
				padding: 0;
			}
			me > li + li {
				border-top: 1px solid var(--sb-border);
			}
		</style>
		for _, schedule := range items {
			<li>@scheduleRow(schedule)</li>
		}
	</ul>
}

templ scheduleRow(schedule apimodels.Response) {
	<a data-schedule-link href={ schedule.Links.Href("self") } hx-get={ schedule.Links.Href("self") } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
		<style>
			me {
				align-items: center;
				color: var(--sb-text);
				display: grid;
				gap: 0.375rem 1rem;
				grid-template-columns: minmax(0, 1fr) auto auto;
				padding: 0.875rem;
				text-decoration: none;
			}
			me:hover {
				background: var(--sb-hover);
				color: var(--sb-text);
			}
			me > [data-copy] {
				min-width: 0;
				overflow-wrap: anywhere;
			}
			me h2 {
				font-size: 0.9375rem;
				font-weight: 650;
				line-height: 1.3;
				margin: 0;
			}
			me [data-template] {
				color: var(--sb-muted);
				font-size: 0.8125rem;
				margin: 0.25rem 0 0;
			}
			me > [data-timing] {
				align-items: flex-end;
				display: flex;
				flex-direction: column;
				font-size: 0.8125rem;
				gap: 0.25rem;
			}
			me [data-deadline] {
				color: var(--sb-muted);
			}
			me > [data-caret] {
				color: var(--sb-muted);
			}
			@media sm- {
				me {
					grid-template-columns: minmax(0, 1fr) auto;
					padding-inline: 0.75rem;
				}
				me > [data-timing] {
					align-items: flex-start;
					flex-direction: row;
					flex-wrap: wrap;
					gap: 0.25rem 1rem;
					grid-column: 1;
				}
				me > [data-caret] {
					grid-column: 2;
					grid-row: 1 / span 2;
				}
			}
		</style>
		<div data-copy>
			<h2>{ schedule.Name }</h2>
			<p data-template>{ schedule.ChoreTemplateName }</p>
		</div>
		<div data-timing>
			<span>{ intervalLabel(schedule.IntervalDays) }</span>
			<span data-deadline>
				if schedule.DeactivatedAt != nil {
					Deactivated
				} else if schedule.ActiveChoreDeadline != nil {
					Due <time datetime={ schedule.ActiveChoreDeadline.Format(time.DateOnly) }>{ schedule.ActiveChoreDeadline.Format("2 Jan 2006") }</time>
				} else {
					No active chore
				}
			</span>
		</div>
		<span data-caret>@viewicons.CaretRight()</span>
	</a>
}

templ collectionPagination(links api.Relations) {
	if links.Href("previous") != "" || links.Href("next") != "" {
		<nav aria-label="Schedule pages">
			<style>
				me {
					display: flex;
					gap: 0.75rem;
					margin-top: 1rem;
				}
				me > a {
					gap: 0.375rem;
				}
				me > a[rel="next"] {
					margin-left: auto;
				}
			</style>
			if href := links.Href("previous"); href != "" {
				<a class="btn btn-outline-secondary" href={ href } hx-get={ href } hx-target="#main" hx-swap="outerHTML" hx-push-url="true" rel="prev">
					@viewicons.CaretLeft()
					<span>Previous</span>
				</a>
			}
			if href := links.Href("next"); href != "" {
				<a class="btn btn-outline-secondary" href={ href } hx-get={ href } hx-target="#main" hx-swap="outerHTML" hx-push-url="true" rel="next">
					<span>Next</span>
					@viewicons.CaretRight()
				</a>
			}
		</nav>
	}
}

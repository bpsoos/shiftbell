package schedules

import (
	apimodels "github.com/bpsoos/shiftbell/internal/models/api/schedules"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ scheduleActions(schedule apimodels.Representation) {
	<div data-detail-actions>
		<style>
			me {
				align-items: center;
				display: flex;
				flex: 0 0 auto;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			me > .btn {
				gap: 0.375rem;
			}
			me > [data-deactivate-action] {
				--bs-btn-border-color: var(--sb-danger);
				--bs-btn-color: var(--sb-danger);
				--bs-btn-hover-border-color: var(--sb-danger);
				--bs-btn-hover-color: var(--sb-danger);
				--bs-btn-hover-bg: color-mix(in srgb, var(--sb-danger) 10%, var(--sb-surface));
				border-color: var(--sb-danger);
				color: var(--sb-danger);
			}
		</style>
		if href := schedule.Actions.Href("edit"); href != "" {
			<a class="btn btn-outline-secondary" data-edit-action href={ href + "/edit" } hx-get={ href + "/edit" } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				@viewicons.PencilSimple()
				<span>Edit</span>
			</a>
		}
		if href := schedule.Actions.Href("deactivate"); href != "" {
			<button class="btn btn-outline-secondary" type="button" data-deactivate-action hx-get={ href } hx-target="#dialog-root" hx-swap="innerHTML" aria-haspopup="dialog">
				@viewicons.Archive()
				<span>Deactivate</span>
			</button>
		}
	</div>
}

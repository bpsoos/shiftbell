package home

import (
	"github.com/bpsoos/shiftbell/internal/models"
	"strconv"
)

templ getChoreBatch(offset int, limit int, result *models.GetChoreTypeBatchResult) {
	<ul class="list-group">
		for _, chore := range result.ChoreTypes {
	<li class="list-group-item"><div>{ "description: " + chore.Description }</div><div>{ "interval days: " + strconv.Itoa(chore.IntervalDays) }</div></li>
		}
	</ul>
	<div class="mt-2 px-3">
		<div class="row ">
			<div class="col text-center btn btn-secondary"
				hx-get={ "/view-settings" + "?offset=" + strconv.Itoa(offset) +"&limit=" + strconv.Itoa(limit) +"&action=set-offset&action-value=" + strconv.Itoa(offset-limit)}
				disabled={
					if offset == 0 {
						"false
					} else {
						"true"
					}
				}
			>
				←
			</div>
			<div class="col-10">
			</div>
			<div class="col text-center btn btn-secondary"
					hx-get={ "/view-settings" + "?offset=" + strconv.Itoa(offset) +"&limit=" + strconv.Itoa(limit) +"&action=set-offset&action-value=" + strconv.Itoa(offset+limit)}
			>
				→
			</div>
		</div>
	</div>
}

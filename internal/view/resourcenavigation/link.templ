package resourcenavigation

templ Link(href string, label string) {
	<a data-resource-link href={ href } hx-get={ href } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
		<style>
			me {
				border-left: 3px solid var(--sb-accent);
				color: var(--sb-muted-strong);
				display: inline-block;
				font-size: 0.6875rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				padding: 0.125rem 0 0.125rem 0.5rem;
				text-decoration: none;
				text-transform: uppercase;
			}
			me:hover,
			me:focus-visible {
				color: var(--sb-text);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}
		</style>
		{ label }
	</a>
}

package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ picker(model viewmodels.Picker) {
	<section aria-labelledby="chore-template-picker-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; gap: 0.375rem; margin-bottom: 1rem; text-decoration: none; }
			me [data-back]:hover { color: var(--sb-text); }
			me [data-panel] { background: var(--sb-surface); border: 1px solid var(--sb-border); border-radius: var(--sb-list-radius); overflow: hidden; }
			me [data-panel-header] { border-bottom: 1px solid var(--sb-border); padding: 1rem 1.125rem; }
			me [data-panel-header] h1 { font-size: 1.125rem; margin: 0; }
			me [data-empty] { color: var(--sb-muted); padding: 2rem 1rem; text-align: center; }
			me [data-empty] p { margin: 0; }
			me [data-template-list] { list-style: none; margin: 0; padding: 0; }
			me [data-template-row] + [data-template-row] { border-top: 1px solid var(--sb-border); }
			me [data-template-option] { align-items: center; color: var(--sb-text); display: flex; gap: 0.75rem; justify-content: space-between; padding: 0.7rem 0.875rem; text-decoration: none; }
			me a[data-template-option]:hover { background: var(--sb-hover); color: var(--sb-text); }
			me [data-template-name] { font-size: 0.9375rem; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			me [data-template-caret] { color: var(--sb-muted); flex: 0 0 auto; opacity: 0.45; }
			me a[data-template-option]:hover [data-template-caret] { color: var(--sb-accent); opacity: 0.85; }
			me [data-pagination] { border-top: 1px solid var(--sb-border); display: flex; gap: 0.75rem; padding: 0.75rem; }
			me [data-page-link] { align-items: center; border-color: var(--sb-border); color: var(--sb-muted); display: inline-flex; gap: 0.375rem; }
			me [data-page-link]:hover { background: var(--sb-background); border-color: var(--sb-border); color: var(--sb-text); }
			me [data-page-link="next"] { margin-left: auto; }
			me [data-manual] { border-top: 1px solid var(--sb-border); padding: 0.875rem; text-align: center; }
			me [data-manual] a { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; text-decoration: none; }
			me [data-manual] a:hover { color: var(--sb-text); }
		</style>
		<div data-picker>
			if model.BackHref != "" {
				<a data-back href={ model.BackHref } hx-get={ model.BackHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
					@viewicons.ArrowLeft()
					<span>Add chore</span>
				</a>
			}
			<div data-panel>
				<header data-panel-header>
					<h1 id="chore-template-picker-heading">Choose a template</h1>
				</header>
				if len(model.Collection.Items) == 0 {
					<div data-empty>
						<p>No active chore templates are available.</p>
					</div>
				} else {
					<ul data-template-list>
						for _, item := range model.Collection.Items {
							<li data-template-row>
								if selectHref := knownLink(item.Links, "select"); selectHref != "" {
									<a data-template-option href={ oneOffCreationHref(selectHref) } hx-get={ oneOffCreationHref(selectHref) } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
										<span data-template-name>{ item.Name }</span>
										<span data-template-caret>@viewicons.CaretRight()</span>
									</a>
								} else {
									<div data-template-option>
										<span data-template-name>{ item.Name }</span>
									</div>
								}
							</li>
						}
					</ul>
				}
				@pickerPagination(model)
				if model.ManualHref != "" {
					<div data-manual>
						<a href={ oneOffCreationHref(model.ManualHref) } hx-get={ oneOffCreationHref(model.ManualHref) } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
							@viewicons.Plus()
							<span>Create from scratch</span>
						</a>
					</div>
				}
			</div>
		</div>
	</section>
}

templ pickerPagination(model viewmodels.Picker) {
	if model.HasPagination() {
		<nav data-pagination aria-label="Chore template picker pages">
			if previous := knownLink(model.Collection.Links, "previous"); previous != "" {
				<a class="btn btn-outline-secondary" data-page-link="previous" href={ previous } hx-get={ previous } hx-target="#main" hx-swap="outerHTML" hx-push-url="true" rel="prev">
					@viewicons.CaretLeft()
					<span>Previous</span>
				</a>
			}
			if next := knownLink(model.Collection.Links, "next"); next != "" {
				<a class="btn btn-outline-secondary" data-page-link="next" href={ next } hx-get={ next } hx-target="#main" hx-swap="outerHTML" hx-push-url="true" rel="next">
					<span>Next</span>
					@viewicons.CaretRight()
				</a>
			}
		</nav>
	}
}

package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ editForm(model viewmodels.EditForm) {
	<section aria-labelledby="edit-chore-template-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
		</style>
		<a
			data-back
			href={ model.CancelHref }
			hx-get={ model.CancelHref }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			@viewicons.ArrowLeft()
			<span>Template</span>
		</a>
		<div data-panel>
			<style>
				me { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow: hidden; }
			</style>
			<header data-panel-header>
				<style>
					me { background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); padding: 0.875rem 1.125rem; }
					me > h1 { font-size: 1.25rem; letter-spacing: -0.02em; margin: 0; }
					@media sm- {
						me { padding-inline: 0.875rem; }
					}
				</style>
				<h1 id="edit-chore-template-heading">Edit template</h1>
			</header>
			<div data-panel-body>
				<style>
					me { padding: 1.125rem; }
					me > [data-help] { color: var(--sb-muted); font-size: 0.875rem; margin: 0 0 1rem; }
					@media sm- {
						me { padding: 0.875rem; }
					}
				</style>
				<p data-help>Changes affect chores created from this template in the future.</p>
				@templateFormFields() {
					<form
						id="edit-chore-template-form"
						action={ model.ActionHref }
						method="post"
						hx-patch={ model.ActionHref }
						hx-target="#main"
						hx-swap="outerHTML"
						if model.SummaryError != "" {
							aria-describedby="edit-chore-template-form-summary"
						}
					>
						@formSummary("edit-chore-template-form-summary", model.SummaryError)
						@templateNameField(model.Name)
						@templateDescriptionField(model.Description)
						<div data-actions>
							<style>
								me { border-top: 1px solid var(--sb-border); display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.25rem; padding-top: 1rem; }
							</style>
							<a
								class="btn btn-secondary"
								href={ model.CancelHref }
								hx-get={ model.CancelHref }
								hx-target="#main"
								hx-swap="outerHTML"
								hx-push-url="true"
							>Cancel</a>
							<button class="btn btn-primary" type="submit">Save changes</button>
						</div>
					</form>
				}
			</div>
		</div>
	</section>
}

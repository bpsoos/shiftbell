package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ editForm(model viewmodels.EditForm) {
	<section aria-labelledby="edit-chore-template-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
			me [data-panel] { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow: hidden; }
			me [data-panel-header] { background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); padding: 0.875rem 1.125rem; }
			me [data-panel-header] h1 { font-size: 1.25rem; letter-spacing: -0.02em; margin: 0; }
			me [data-panel-body] { padding: 1.125rem; }
			me [data-help] { color: var(--sb-muted); font-size: 0.875rem; margin: 0 0 1rem; }
			me [data-field] { margin-bottom: 1rem; }
			me [data-field] > .form-label { font-size: 0.875rem; font-weight: 650; }
			me .form-control { background-color: var(--sb-input); border-color: var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-text); }
			me .form-control:focus { background-color: var(--sb-input); border-color: var(--sb-accent); box-shadow: none; color: var(--sb-text); }
			me .form-control.is-invalid, me .form-control.is-invalid:focus { border-color: var(--sb-danger); box-shadow: none; }
			me .form-control:focus-visible { box-shadow: none; outline: 2px solid var(--sb-focus); outline-offset: 2px; }
			me .invalid-feedback { color: var(--sb-danger); }
			me .invalid-feedback[data-visible] { display: block; }
			me [data-actions] { border-top: 1px solid var(--sb-border); display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.25rem; padding-top: 1rem; }
			@media sm- {
				me [data-panel-header] { padding-inline: 0.875rem; }
				me [data-panel-body] { padding: 0.875rem; }
			}
		</style>
		<a
			data-back
			href={ model.CancelHref }
			hx-get={ model.CancelHref }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			@viewicons.ArrowLeft()
			<span>Template</span>
		</a>
		<div data-panel>
			<header data-panel-header>
				<h1 id="edit-chore-template-heading">Edit template</h1>
			</header>
			<div data-panel-body>
				<p data-help>Changes affect chores created from this template in the future.</p>
				<form
					id="edit-chore-template-form"
					action={ model.ActionHref }
					method="post"
					hx-patch={ model.ActionHref }
					hx-target="#main"
					hx-swap="outerHTML"
					if model.SummaryError != "" {
						aria-describedby="edit-chore-template-form-summary"
					}
				>
					@formSummary("edit-chore-template-form-summary", model.SummaryError)
					@editNameField(model.Name)
					@editDescriptionField(model.Description)
					<div data-actions>
						<a
							class="btn btn-secondary"
							href={ model.CancelHref }
							hx-get={ model.CancelHref }
							hx-target="#main"
							hx-swap="outerHTML"
							hx-push-url="true"
						>Cancel</a>
						<button class="btn btn-primary" type="submit">Save changes</button>
					</div>
				</form>
			</div>
		</div>
	</section>
}

templ formSummary(id string, message string) {
	if message != "" {
		<div id={ id } class="alert alert-danger" role="alert" tabindex="-1">
			<strong>Could not submit the form.</strong>
			<div>{ message }</div>
		</div>
	} else {
		<div id={ id } hidden></div>
	}
}

templ editNameField(field viewmodels.Field) {
	<div data-field>
		<label class="form-label" for="edit-chore-template-name">Name</label>
		<input
			class={ formControlClass("form-control", field.Error) }
			type="text"
			id="edit-chore-template-name"
			name="name"
			value={ field.Value }
			maxlength="200"
			if field.Error != "" {
				aria-describedby="edit-chore-template-name-error"
				aria-invalid="true"
			}
			required
		/>
		@fieldFeedback("edit-chore-template-name-error", field.Error)
	</div>
}

templ editDescriptionField(field viewmodels.Field) {
	<div data-field>
		<label class="form-label" for="edit-chore-template-description">Description</label>
		<textarea
			class={ formControlClass("form-control", field.Error) }
			id="edit-chore-template-description"
			name="description"
			rows="4"
			maxlength="2000"
			if field.Error != "" {
				aria-describedby="edit-chore-template-description-error"
				aria-invalid="true"
			}
		>{ field.Value }</textarea>
		@fieldFeedback("edit-chore-template-description-error", field.Error)
	</div>
}

templ fieldFeedback(id string, message string) {
	if message != "" {
		<div id={ id } class="invalid-feedback" data-visible role="alert">{ message }</div>
	} else {
		<div id={ id } class="invalid-feedback"></div>
	}
}

package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ createForm(model viewmodels.CreateForm) {
	<section aria-labelledby="create-template-heading">
		<style>
			me {
				margin-inline: auto;
				max-width: 42rem;
			}
			me > a {
				align-items: center;
				color: var(--sb-muted);
				display: inline-flex;
				font-size: 0.875rem;
				gap: 0.375rem;
				margin-bottom: 1.125rem;
				text-decoration: none;
			}
			me > a:hover,
			me > a:focus-visible {
				color: var(--sb-text);
			}
		</style>
		<a data-back href={ model.CancelHref } hx-get={ model.CancelHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
			@viewicons.ArrowLeft()
			<span>Templates</span>
		</a>
		@createFormPanel() {
			@templateFormFields() {
				<form action={ model.ActionHref } method="post" hx-post={ model.ActionHref } hx-target="#main" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">
					if model.SummaryError != "" {
						@formSummary("create-template-summary", model.SummaryError)
					}
					@templateNameField(model.Name)
					@templateDescriptionField(model.Description)
					@createFormActions(model.CancelHref)
				</form>
			}
		}
	</section>
}

templ createFormPanel() {
	<div>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
			}
		</style>
		<header>
			<style>
				me {
					background: var(--sb-subtle);
					border-bottom: 1px solid var(--sb-border);
					border-left: 3px solid var(--sb-accent);
					padding: 0.875rem 1.125rem;
				}
				me > h1 {
					font-size: 1.25rem;
					letter-spacing: -0.02em;
					margin: 0;
				}
			</style>
			<h1 id="create-template-heading">New template</h1>
		</header>
		<div>
			<style>
				me {
					padding: 1.125rem;
				}
				@media sm- {
					me {
						padding: 0.875rem;
					}
				}
			</style>
			{ children... }
		</div>
	</div>
}

templ createFormActions(cancelHref string) {
	<div>
		<style>
			me {
				border-top: 1px solid var(--sb-border);
				display: flex;
				gap: 0.75rem;
				justify-content: flex-end;
				margin-top: 1.25rem;
				padding-top: 1rem;
			}
		</style>
		<a class="btn btn-secondary" href={ cancelHref } hx-get={ cancelHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">Cancel</a>
		<button class="btn btn-primary" type="submit">Create template</button>
	</div>
}

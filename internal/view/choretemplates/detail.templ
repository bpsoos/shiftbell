package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ detail(t *Templater, model viewmodels.Detail) {
	<section aria-labelledby="chore-template-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
			me > article { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow-wrap: anywhere; padding: 1.5rem 1.25rem 1.25rem; position: relative; }
			me > article::before { background: var(--sb-accent); content: ""; height: 3px; left: 0; position: absolute; right: 0; top: 0; }
			me > article h1 { font-size: 1.875rem; letter-spacing: -0.035em; line-height: 1.1; margin: 0 0 1rem; }
			me [data-description] { margin: 0; }
			me [data-description][data-empty] { color: var(--sb-muted); }
			me [data-deactivated] { border-top: 1px solid var(--sb-border); color: var(--sb-muted); font-size: 0.8125rem; margin: 1rem 0 0; padding-top: 0.75rem; }
			@media sm- {
				me > article { padding: 1.25rem 1rem 1rem; }
				me > article h1 { font-size: 1.625rem; }
			}
		</style>
		if model.CollectionHref != "" {
			<a data-back href={ model.CollectionHref } hx-get={ model.CollectionHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				@viewicons.ArrowLeft()
				<span>Templates</span>
			</a>
		}
		<article>
			<h1 id="chore-template-heading">{ model.ChoreTemplate.Name }</h1>
			if model.ChoreTemplate.Description != "" {
				<p data-description>{ model.ChoreTemplate.Description }</p>
			} else {
				<p data-description data-empty>No description.</p>
			}
			if model.ChoreTemplate.DeactivatedAt != nil {
				<p data-deactivated>Deactivated { t.formatTime(*model.ChoreTemplate.DeactivatedAt) }</p>
			}
		</article>
	</section>
}

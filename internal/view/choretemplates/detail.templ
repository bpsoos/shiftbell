package choretemplates

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ detail(t *Templater, model viewmodels.Detail) {
	<section aria-labelledby="chore-template-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
			me [data-notice] { align-items: center; background: var(--sb-surface); border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-text); display: flex; font-size: 0.875rem; gap: 0.5rem; margin-bottom: 0.875rem; padding: 0.625rem 0.75rem; }
			me [data-notice] svg { color: var(--sb-muted); flex: 0 0 auto; }
			me > article { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow-wrap: anywhere; padding: 1.5rem 1.25rem 1.25rem; position: relative; }
			me > article::before { background: var(--sb-accent); content: ""; height: 3px; left: 0; position: absolute; right: 0; top: 0; }
			me [data-detail-header] { align-items: flex-start; display: flex; gap: 1rem; justify-content: space-between; margin-bottom: 1rem; }
			me [data-detail-actions] { align-items: center; display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
			me > article h1 { font-size: 1.875rem; letter-spacing: -0.035em; line-height: 1.1; margin: 0; }
			me [data-edit-action], me [data-deactivate-action] { gap: 0.375rem; }
			me [data-deactivate-action] { --bs-btn-active-bg: color-mix(in srgb, var(--sb-danger) 14%, var(--sb-surface)); --bs-btn-active-border-color: var(--sb-danger); --bs-btn-active-color: var(--sb-danger); --bs-btn-border-color: var(--sb-danger); --bs-btn-color: var(--sb-danger); --bs-btn-hover-bg: color-mix(in srgb, var(--sb-danger) 10%, var(--sb-surface)); --bs-btn-hover-border-color: var(--sb-danger); --bs-btn-hover-color: var(--sb-danger); border-color: var(--sb-danger); color: var(--sb-danger); }
			me [data-deactivate-action]:hover, me [data-deactivate-action]:focus-visible, me [data-deactivate-action]:active { border-color: var(--sb-danger); color: var(--sb-danger); }
			me [data-description] { margin: 0; }
			me [data-description][data-empty] { color: var(--sb-muted); }
			me [data-deactivated] { border-top: 1px solid var(--sb-border); color: var(--sb-muted); font-size: 0.8125rem; margin: 1rem 0 0; padding-top: 0.75rem; }
			@media sm- {
				me > article { padding: 1.25rem 1rem 1rem; }
				me > article h1 { font-size: 1.625rem; }
				me [data-edit-action], me [data-deactivate-action] { padding-inline: 0.625rem; }
			}
		</style>
		if model.CollectionHref != "" {
			<a data-back href={ model.CollectionHref } hx-get={ model.CollectionHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				@viewicons.ArrowLeft()
				<span>Templates</span>
			</a>
		}
		if model.Notice != "" {
			<div data-notice role="status">
				@viewicons.CheckCircle()
				<span>{ model.Notice }</span>
			</div>
		}
		<article>
			<div data-detail-header>
				<h1 id="chore-template-heading">{ model.ChoreTemplate.Name }</h1>
				if model.EditHref != "" || model.DeactivateHref != "" {
					<div data-detail-actions>
						if model.EditHref != "" {
							<a
								class="btn btn-outline-secondary"
								data-edit-action
								href={ model.EditHref }
								hx-get={ model.EditHref }
								hx-target="#main"
								hx-swap="outerHTML"
								hx-push-url="true"
							>
								@viewicons.PencilSimple()
								<span>Edit</span>
							</a>
						}
						if model.DeactivateHref != "" {
							<button
								class="btn btn-outline-secondary"
								type="button"
								data-deactivate-action
								hx-get={ model.DeactivateHref }
								hx-target="#dialog-root"
								hx-swap="innerHTML"
								aria-haspopup="dialog"
							>
								@viewicons.Archive()
								<span>Deactivate</span>
							</button>
						}
					</div>
				}
			</div>
			if model.ChoreTemplate.Description != "" {
				<p data-description>{ model.ChoreTemplate.Description }</p>
			} else {
				<p data-description data-empty>No description.</p>
			}
			if model.ChoreTemplate.DeactivatedAt != nil {
				<p data-deactivated>Deactivated { t.formatTime(*model.ChoreTemplate.DeactivatedAt) }</p>
			}
		</article>
	</section>
}

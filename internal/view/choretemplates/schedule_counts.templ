package choretemplates

import (
	"strconv"
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"
)

templ templateScheduleCounts(model viewmodels.Detail) {
	<section data-schedule-counts aria-labelledby="template-schedules-heading">
		<style>
			me {
				border-top: 1px solid var(--sb-border);
				margin-top: 1.5rem;
				padding-top: 1.25rem;
			}
			me > h2 {
				font-size: 1.0625rem;
				font-weight: 700;
				margin: 0 0 0.625rem;
			}
			me > [data-count-links] {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem 1.5rem;
				margin: 0;
			}
			me button {
				align-items: baseline;
				background: none;
				border: 0;
				color: var(--sb-text);
				cursor: pointer;
				display: flex;
				gap: 0.5rem;
				min-height: 2.5rem;
				padding: 0.5rem 0;
			}
			me button > span {
				color: var(--sb-muted);
				font-size: 0.8125rem;
				font-weight: 400;
			}
			me button > strong {
				font-size: 0.9375rem;
				font-weight: 600;
				margin: 0;
			}
			me button:hover > span,
			me button:focus-visible > span {
				color: var(--sb-text);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}
			me button[aria-expanded="true"] > span {
				color: var(--sb-text);
				font-weight: 600;
			}
		</style>
		<h2 id="template-schedules-heading">Schedules</h2>
		<div data-count-links>
			<button type="button" data-template-schedules data-schedule-state="active" hx-get={ model.ChoreTemplate.Links.Href("self") + "/schedules?state=active" } hx-target="#template-schedule-list" hx-swap="innerHTML" hx-sync="closest section:replace" aria-expanded="false" aria-controls="template-schedule-list">
				<span>Active</span>
				<strong data-active-schedules>{ strconv.Itoa(model.ActiveScheduleCount) }</strong>
			</button>
			<button type="button" data-template-schedules data-schedule-state="deactivated" hx-get={ model.ChoreTemplate.Links.Href("self") + "/schedules?state=deactivated" } hx-target="#template-schedule-list" hx-swap="innerHTML" hx-sync="closest section:replace" aria-expanded="false" aria-controls="template-schedule-list">
				<span>Deactivated</span>
				<strong data-deactivated-schedules>{ strconv.Itoa(model.DeactivatedScheduleCount) }</strong>
			</button>
		</div>
		<div id="template-schedule-list" aria-live="polite" tabindex="-1"></div>
	</section>
}

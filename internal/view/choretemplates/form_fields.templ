package choretemplates

import viewmodels "github.com/bpsoos/shiftbell/internal/models/view/choretemplates"

templ templateFormFields() {
	<div data-form-region>
		<style>
			me [data-field] {
				margin-bottom: 1rem;
			}
			me [data-field] > .form-label {
				font-size: 0.875rem;
				font-weight: 650;
			}
			me .form-control {
				background-color: var(--sb-input);
				border-color: var(--sb-control-border);
				border-radius: var(--sb-radius-control);
				color: var(--sb-text);
			}
			me .form-control:focus {
				background-color: var(--sb-input);
				border-color: var(--sb-accent);
				box-shadow: none;
				color: var(--sb-text);
			}
			me .form-control.is-invalid,
			me .form-control.is-invalid:focus {
				border-color: var(--sb-danger);
				box-shadow: none;
			}
			me .form-control:focus-visible {
				box-shadow: none;
				outline: 2px solid var(--sb-focus);
				outline-offset: 2px;
			}
			me .invalid-feedback {
				color: var(--sb-danger);
			}
			me .invalid-feedback[data-visible] {
				display: block;
			}
		</style>
		{ children... }
	</div>
}

templ templateNameField(field viewmodels.Field) {
	<div data-field>
		<label class="form-label" for="chore-template-name">Name</label>
		<input class={ formControlClass("form-control", field.Error) } type="text" id="chore-template-name" name="name" value={ field.Value } maxlength="200" required autofocus
			if field.Error != "" {
				aria-describedby="chore-template-name-error"
				aria-invalid="true"
			}
		/>
		@fieldFeedback("chore-template-name-error", field.Error)
	</div>
}

templ templateDescriptionField(field viewmodels.Field) {
	<div data-field>
		<label class="form-label" for="chore-template-description">Description</label>
		<textarea class={ formControlClass("form-control", field.Error) } id="chore-template-description" name="description" rows="4" maxlength="2000"
			if field.Error != "" {
				aria-describedby="chore-template-description-error"
				aria-invalid="true"
			}
		>{ field.Value }</textarea>
		@fieldFeedback("chore-template-description-error", field.Error)
	</div>
}

templ formSummary(id string, message string) {
	if message != "" {
		<div id={ id } class="alert alert-danger" role="alert" tabindex="-1">
			<strong>Could not submit the form.</strong>
			<div>{ message }</div>
		</div>
	} else {
		<div id={ id } hidden></div>
	}
}

templ fieldFeedback(id string, message string) {
	if message != "" {
		<div id={ id } class="invalid-feedback" data-visible role="alert">{ message }</div>
	} else {
		<div id={ id } class="invalid-feedback"></div>
	}
}

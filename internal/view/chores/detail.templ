package chores

import (
	"time"

	choreapimodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
	markdownview "github.com/bpsoos/shiftbell/internal/view/markdown"
	"github.com/bpsoos/shiftbell/internal/view/resourcenavigation"
)

templ detailContent(t *Templater, model choreviewmodels.Detail, today time.Time) {
	<section
		aria-labelledby="chore-heading"
		hx-get={ model.Chore.Links.Href("self") }
		hx-trigger="choreCompleted from:body"
		hx-target="#main"
		hx-swap="outerHTML"
	>
		<style>
			me {
				margin-inline: auto;
				max-width: 42rem;
			}
			me > [data-back] {
				align-items: center;
				color: var(--sb-muted);
				display: inline-flex;
				font-size: 0.875rem;
				gap: 0.375rem;
				margin-bottom: 1.125rem;
				text-decoration: none;
			}
			me > [data-back]:hover,
			me > [data-back]:focus-visible {
				color: var(--sb-text);
			}
		</style>
		if model.BackHref != "" {
			<a
				data-back
				href={ model.BackHref }
				hx-get={ model.BackHref }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@viewicons.ArrowLeft()
				<span>Chores</span>
			</a>
		}
		if model.Notice != "" {
			@detailNotice(model.Notice)
		}
		@detailCard(t, model.Chore, model.EditHref, model.DeleteHref, today)
	</section>
}

templ detailNotice(notice string) {
	<div data-notice role="status">
		<style>
			me {
				align-items: center;
				background: var(--sb-surface);
				border: 1px solid var(--sb-border);
				border-left: 3px solid var(--sb-accent);
				color: var(--sb-text);
				display: flex;
				font-size: 0.875rem;
				gap: 0.5rem;
				margin-bottom: 0.875rem;
				padding: 0.625rem 0.75rem;
			}
			me > svg {
				color: var(--sb-muted);
				flex: 0 0 auto;
			}
		</style>
		@viewicons.CheckCircle()
		<span>{ notice }</span>
	</div>
}

templ detailCard(t *Templater, chore choreapimodels.Representation, editHref string, deleteHref string, today time.Time) {
	<article data-chore-detail>
		<style>
			me {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				overflow-wrap: anywhere;
				padding: 1.5rem 1.25rem 1.25rem;
				position: relative;
			}
			me::before {
				background: var(--sb-accent);
				content: "";
				height: 3px;
				left: 0;
				position: absolute;
				right: 0;
				top: 0;
			}
			me > [data-description] {
				margin: 1.25rem 0 0;
			}
			me > [data-repeating] {
				margin-top: 1.25rem;
			}
			me > [data-completion-action] {
				border-top: 1px solid var(--sb-border);
				display: flex;
				justify-content: center;
				margin-top: 1.5rem;
				padding-top: 1.25rem;
			}
			me > [data-completion-action] > button {
				gap: 0.375rem;
			}
			@media sm- {
				me {
					padding: 1.25rem 1rem 1rem;
				}
			}
		</style>
		@choreDetailHeader(chore.Name, editHref, deleteHref)
		@choreMetadata(t, chore, today)
		if chore.Description != "" {
			<div data-description>
				@markdownview.Description(chore.Description)
			</div>
		}
		if chore.ScheduleId != nil {
			<div data-repeating>
				@resourcenavigation.Link(scheduleHref(*chore.ScheduleId), "View schedule")
			</div>
		}
		if completeHref := chore.Actions.Href("complete"); completeHref != "" {
			<div data-completion-action>
				<button
					class="btn btn-primary"
					type="button"
					data-complete-chore
					hx-get={ completeHref }
					hx-target="#dialog-root"
					hx-swap="innerHTML"
					aria-haspopup="dialog"
				>
					@viewicons.CheckCircle()
					<span>Complete</span>
				</button>
			</div>
		}
	</article>
}

templ choreDetailHeader(name string, editHref string, deleteHref string) {
	<div data-detail-header>
		<style>
			me {
				align-items: flex-start;
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: space-between;
			}
			me > h1 {
				flex: 1 1 15rem;
				font-size: 1.875rem;
				letter-spacing: -0.035em;
				line-height: 1.1;
				margin: 0;
				min-width: 0;
			}
			@media sm- {
				me > h1 {
					font-size: 1.625rem;
				}
			}
		</style>
		<h1 id="chore-heading">{ name }</h1>
		@choreDetailActions(editHref, deleteHref)
	</div>
}

templ choreDetailActions(editHref string, deleteHref string) {
	<div data-detail-actions>
		<style>
			me {
				align-items: center;
				display: flex;
				flex: 0 0 auto;
				flex-wrap: wrap;
				gap: 0.5rem;
				justify-content: flex-end;
			}
			me > [data-edit-action],
			me > [data-delete-action] {
				gap: 0.375rem;
			}
			me > [data-delete-action] {
				--bs-btn-active-bg: color-mix(
					in srgb,
					var(--sb-danger) 14%,
					var(--sb-surface)
				);
				--bs-btn-active-border-color: var(--sb-danger);
				--bs-btn-active-color: var(--sb-danger);
				--bs-btn-border-color: var(--sb-danger);
				--bs-btn-color: var(--sb-danger);
				--bs-btn-hover-bg: color-mix(
					in srgb,
					var(--sb-danger) 10%,
					var(--sb-surface)
				);
				--bs-btn-hover-border-color: var(--sb-danger);
				--bs-btn-hover-color: var(--sb-danger);
				border-color: var(--sb-danger);
				color: var(--sb-danger);
			}
			me > [data-delete-action]:hover,
			me > [data-delete-action]:focus-visible,
			me > [data-delete-action]:active {
				border-color: var(--sb-danger);
				color: var(--sb-danger);
			}
			@media sm- {
				me > [data-edit-action],
				me > [data-delete-action] {
					padding-inline: 0.625rem;
				}
			}
		</style>
		if editHref != "" {
			<a
				class="btn btn-outline-secondary"
				data-edit-action
				href={ editHref }
				hx-get={ editHref }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@viewicons.PencilSimple()
				<span>Edit</span>
			</a>
		}
		if deleteHref != "" {
			<button
				class="btn btn-outline-secondary"
				type="button"
				data-delete-action
				hx-get={ deleteHref }
				hx-target="#dialog-root"
				hx-swap="innerHTML"
				aria-haspopup="dialog"
			>
				@viewicons.Trash()
				<span>Delete</span>
			</button>
		}
	</div>
}

templ choreMetadata(t *Templater, chore choreapimodels.Representation, today time.Time) {
	<div data-detail-metadata data-has-owner?={ t.profilesUIEnabled }>
		<style>
			me {
				align-items: center;
				border-top: 1px solid var(--sb-border);
				display: grid;
				gap: 1rem;
				grid-template-columns: minmax(0, 1fr);
				margin-top: 1rem;
				padding-top: 0.875rem;
			}
			me[data-has-owner] {
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			}
			me > [data-chore-assignment] {
				justify-self: end;
				max-width: 100%;
				min-width: 0;
			}
		</style>
		if chore.CompletedOn != nil {
			@choreCompletion(t, chore)
		} else {
			@choreDeadline(t, chore.Deadline, today)
		}
		if t.profilesUIEnabled {
			@choreAssignment(chore)
		}
	</div>
}

templ choreDeadline(t *Templater, deadline string, today time.Time) {
	<div data-deadline>
		<style>
			me > [data-due-state] {
				align-items: center;
				display: flex;
				font-size: 0.9375rem;
				font-weight: 650;
				gap: 0.375rem;
			}
			me > [data-due-state="overdue"] {
				color: var(--sb-danger);
			}
			me > [data-due-state="today"] {
				color: var(--sb-warning);
			}
			me > [data-exact-deadline] {
				color: var(--sb-muted);
				display: block;
				font-size: 0.8125rem;
				margin-top: 0.125rem;
			}
		</style>
		<div data-due-state={ t.deadlineState(deadline, today) }>
			if t.deadlineState(deadline, today) == "overdue" {
				@viewicons.WarningCircle()
			}
			{ t.relativeDeadline(deadline, today) }
		</div>
		<time data-exact-deadline datetime={ deadline }>Due { t.exactDeadline(deadline) }</time>
	</div>
}

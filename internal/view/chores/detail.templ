package chores

import (
	"time"

	choreapimodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ detailContent(t *Templater, model choreviewmodels.Detail, today time.Time) {
	<section aria-labelledby="chore-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
		</style>
		if model.BackHref != "" {
			<a
				data-back
				href={ model.BackHref }
				hx-get={ model.BackHref }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@viewicons.ArrowLeft()
				<span>Chores</span>
			</a>
		}
		if model.Notice != "" {
			@detailNotice(model.Notice)
		}
		@detailCard(t, model.Chore, model.EditHref, model.DeleteHref, today)
	</section>
}

templ detailNotice(notice string) {
	<div data-notice role="status">
		<style>
			me { align-items: center; background: var(--sb-surface); border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-text); display: flex; font-size: 0.875rem; gap: 0.5rem; margin-bottom: 0.875rem; padding: 0.625rem 0.75rem; }
			me > svg { color: var(--sb-muted); flex: 0 0 auto; }
		</style>
		@viewicons.CheckCircle()
		<span>{ notice }</span>
	</div>
}

templ detailCard(t *Templater, chore choreapimodels.Representation, editHref string, deleteHref string, today time.Time) {
	<article data-chore-detail>
		<style>
			me { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow-wrap: anywhere; padding: 1.5rem 1.25rem 1.25rem; position: relative; }
			me::before { background: var(--sb-accent); content: ""; height: 3px; left: 0; position: absolute; right: 0; top: 0; }
			me > [data-description] { line-height: 1.55; margin: 1.25rem 0 0; white-space: pre-wrap; }
			me > [data-repeating] { border-left: 3px solid var(--sb-accent); color: var(--sb-muted-strong); display: inline-block; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; margin-top: 1.25rem; padding: 0.125rem 0 0.125rem 0.5rem; text-transform: uppercase; }
			@media sm- {
				me { padding: 1.25rem 1rem 1rem; }
			}
		</style>
		@choreDetailHeader(chore.Name, editHref, deleteHref)
		@choreDeadline(t, chore.Deadline, today)
		if chore.Description != "" {
			<p data-description>{ chore.Description }</p>
		}
		if chore.ScheduleId != nil {
			<span data-repeating>Repeating chore</span>
		}
	</article>
}

templ choreDetailHeader(name string, editHref string, deleteHref string) {
	<div data-detail-header>
		<style>
			me { align-items: flex-start; display: flex; gap: 1rem; justify-content: space-between; }
			me > h1 { font-size: 1.875rem; letter-spacing: -0.035em; line-height: 1.1; margin: 0; }
			@media sm- {
				me > h1 { font-size: 1.625rem; }
			}
		</style>
		<h1 id="chore-heading">{ name }</h1>
		@choreDetailActions(editHref, deleteHref)
	</div>
}

templ choreDetailActions(editHref string, deleteHref string) {
	<div data-detail-actions>
		<style>
			me { align-items: center; display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
			me > [data-edit-action], me > [data-delete-action] { gap: 0.375rem; }
			me > [data-delete-action] { --bs-btn-active-bg: color-mix(in srgb, var(--sb-danger) 14%, var(--sb-surface)); --bs-btn-active-border-color: var(--sb-danger); --bs-btn-active-color: var(--sb-danger); --bs-btn-border-color: var(--sb-danger); --bs-btn-color: var(--sb-danger); --bs-btn-hover-bg: color-mix(in srgb, var(--sb-danger) 10%, var(--sb-surface)); --bs-btn-hover-border-color: var(--sb-danger); --bs-btn-hover-color: var(--sb-danger); border-color: var(--sb-danger); color: var(--sb-danger); }
			me > [data-delete-action]:hover, me > [data-delete-action]:focus-visible, me > [data-delete-action]:active { border-color: var(--sb-danger); color: var(--sb-danger); }
			@media sm- {
				me > [data-edit-action], me > [data-delete-action] { padding-inline: 0.625rem; }
			}
		</style>
		<a
			class="btn btn-outline-secondary"
			data-edit-action
			href={ editHref }
			hx-get={ editHref }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			@viewicons.PencilSimple()
			<span>Edit</span>
		</a>
		<button
			class="btn btn-outline-secondary"
			type="button"
			data-delete-action
			hx-get={ deleteHref }
			hx-target="#dialog-root"
			hx-swap="innerHTML"
			aria-haspopup="dialog"
		>
			@viewicons.Trash()
			<span>Delete</span>
		</button>
	</div>
}

templ choreDeadline(t *Templater, deadline string, today time.Time) {
	<div data-deadline>
		<style>
			me { border-top: 1px solid var(--sb-border); margin-top: 1rem; padding-top: 0.875rem; }
			me > [data-due-state] { align-items: center; display: flex; font-size: 0.9375rem; font-weight: 650; gap: 0.375rem; }
			me > [data-due-state="overdue"] { color: var(--sb-danger); }
			me > [data-due-state="today"] { color: var(--sb-warning); }
			me > [data-exact-deadline] { color: var(--sb-muted); display: block; font-size: 0.8125rem; margin-top: 0.125rem; }
		</style>
		<div data-due-state={ t.deadlineState(deadline, today) }>
			if t.deadlineState(deadline, today) == "overdue" {
				@viewicons.WarningCircle()
			}
			{ t.relativeDeadline(deadline, today) }
		</div>
		<time data-exact-deadline datetime={ deadline }>Due { t.exactDeadline(deadline) }</time>
	</div>
}

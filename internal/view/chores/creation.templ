package chores

import (
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ creationContent(model choreviewmodels.Creation) {
	@creationPage(model.BackHref) {
		switch model.Creation.Step {
			case "source":
				@creationSource(model)
			case "recurrence":
				@creationRecurrence(model)
			default:
				<div class="alert alert-danger" data-unavailable role="alert">
					<h1 id="create-chore-heading" class="h4">Unable to create chore</h1>
					<p>The creation step is not available.</p>
				</div>
		}
	}
}

templ creationPage(backHref string) {
	<section aria-labelledby="create-chore-heading">
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; gap: 0.375rem; margin-bottom: 1rem; text-decoration: none; }
			me > [data-back]:hover { color: var(--sb-text); }
			me [data-panel] { background: var(--sb-surface); border: 1px solid var(--sb-border); border-radius: var(--sb-radius); overflow: hidden; }
			me [data-panel-header] { border-bottom: 1px solid var(--sb-border); padding: 1rem 1.125rem; }
			me [data-panel-header] h1 { font-size: 1.125rem; margin: 0; }
			me [data-panel-body] { padding: 1.125rem; }
			me [data-panel-body] > p:first-child { color: var(--sb-muted); margin-bottom: 1rem; }
			me [data-options] { display: grid; gap: 0.5rem; }
			me [data-option] { align-items: center; border: 1px solid var(--sb-border); border-radius: var(--sb-radius-sm); color: var(--sb-text); display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr) auto; padding: 0.75rem; text-decoration: none; }
			me [data-option]:hover { background: rgb(255 255 255 / 3%); border-color: var(--sb-muted); color: var(--sb-text); }
			me [data-option-title] { display: block; font-size: 0.9375rem; font-weight: 700; }
			me [data-option-description] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.35; margin-top: 0.125rem; }
			me [data-option-caret] { color: var(--sb-muted); }
			me [data-option]:hover [data-option-caret] { color: var(--sb-accent); }
			me [data-selected] { border-bottom: 1px solid var(--sb-border); margin-bottom: 1.25rem; padding-bottom: 1rem; }
			me [data-caption] { color: var(--sb-muted); font-size: 0.75rem; margin-bottom: 0.125rem; text-transform: uppercase; }
			me [data-selected] p { margin-bottom: 0; }
			me [data-field] { margin-bottom: 1rem; }
			me .form-control { background: var(--sb-background); border-color: var(--sb-border); color: var(--sb-text); }
			me [data-save-template] { align-items: flex-start; background: rgb(255 255 255 / 2%); border-radius: var(--sb-radius-sm); cursor: pointer; display: flex; gap: 0.625rem; padding: 0.625rem 0.75rem; }
			me [data-save-template] .form-check-input { background-color: var(--sb-surface); border-color: var(--sb-border); flex: 0 0 auto; margin: 0.2rem 0 0; }
			me [data-save-template] .form-check-input:checked { background-color: var(--sb-accent); border-color: var(--sb-accent); }
			me [data-save-template-copy] { display: block; }
			me [data-save-template-title] { display: block; font-size: 0.875rem; font-weight: 600; }
			me [data-save-template-help] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.35; margin-top: 0.125rem; }
			me .invalid-feedback[data-visible] { display: block; }
			me [data-actions] { display: flex; gap: 0.75rem; justify-content: flex-end; }
			me [data-primary-action] { align-items: center; background: var(--sb-accent); border-color: var(--sb-accent); color: var(--sb-accent-text); display: inline-flex; font-weight: 700; gap: 0.375rem; }
			me [data-primary-action]:hover { background: var(--sb-accent-hover); border-color: var(--sb-accent-hover); color: var(--sb-accent-text); }
			me [data-unavailable] { margin-bottom: 0; }
			me [data-unavailable] p { margin-bottom: 0; }
		</style>
		if backHref != "" {
			<a
				class="link-secondary"
				data-back
				href={ backHref }
				hx-get={ backHref }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@viewicons.ArrowLeft()
				<span>Chores</span>
			</a>
		}
		{ children... }
	</section>
}

templ creationSource(model choreviewmodels.Creation) {
	<div data-panel>
		<header data-panel-header>
			<h1 id="create-chore-heading">Add chore</h1>
		</header>
		<div data-panel-body>
			<p>Choose how to define this chore.</p>
			if model.HasSourceOptions() {
				<div data-options>
					if model.SpecifyNewHref != "" {
						@creationOption(oneOffCreationHref(model.SpecifyNewHref), "Create from scratch", "Enter a name, description, and deadline.")
					}
					if model.SelectTemplateHref != "" {
						@creationOption(model.SelectTemplateHref, "Use a template", "Start with a reusable chore definition.")
					}
				</div>
			} else {
				<div class="alert alert-danger" data-unavailable role="alert">No creation source is available.</div>
			}
		</div>
	</div>
}

templ creationRecurrence(model choreviewmodels.Creation) {
	<div data-panel>
		<header data-panel-header>
			<h1 id="create-chore-heading">Add chore</h1>
		</header>
		<div data-panel-body>
			if model.Creation.Template != nil {
				<div data-selected>
					<div data-caption>Selected template</div>
					<strong>{ model.Creation.Template.Name }</strong>
					if model.Creation.Template.Description != "" {
						<p>{ model.Creation.Template.Description }</p>
					}
				</div>
			}
			if model.OneOffHref != "" {
				<div data-options>
					@creationOption(model.OneOffHref, "Continue", "Set the deadline and add this chore.")
				</div>
			} else {
				<div class="alert alert-danger" data-unavailable role="alert">Chore creation is not available.</div>
			}
		</div>
	</div>
}

templ creationOption(href string, label string, description string) {
	<a
		data-option
		href={ href }
		hx-get={ href }
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url="true"
	>
		<span>
			<span data-option-title>{ label }</span>
			<span data-option-description>{ description }</span>
		</span>
		<span data-option-caret>@viewicons.CaretRight()</span>
	</a>
}

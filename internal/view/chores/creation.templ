package chores

import (
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ creationContent(model choreviewmodels.Creation) {
	@creationPage(model.BackHref) {
		switch model.Creation.Step {
			case "source":
				@creationSource(model)
			case "recurrence":
				@creationRecurrence(model)
			default:
				<div class="alert alert-danger" data-unavailable role="alert">
					<h1 id="create-chore-heading" class="h4">Unable to create chore</h1>
					<p>The creation step is not available.</p>
				</div>
		}
	}
}

templ creationPage(backHref string) {
	@panelPage(backHref, "Chores", "create-chore-heading") {
		{ children... }
	}
}

templ panelPage(backHref string, backLabel string, headingId string) {
	<section aria-labelledby={ headingId }>
		<style>
			me { margin-inline: auto; max-width: 42rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
			me [data-panel] { background: var(--sb-surface); border: 2px solid var(--sb-frame); overflow: hidden; }
			me [data-panel-header] { background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); padding: 0.875rem 1.125rem; }
			me [data-panel-header] h1 { font-size: 1.25rem; letter-spacing: -0.02em; margin: 0; }
			me [data-panel-body] { padding: 1.125rem; }
			me [data-panel-body] > p:first-child { color: var(--sb-muted); margin-bottom: 1rem; }
			me .alert { background: var(--sb-surface); border: 1px solid var(--sb-border); border-radius: var(--sb-radius-surface); color: var(--sb-text); }
			me .alert-danger { border-left: 3px solid var(--sb-danger); color: var(--sb-text); }
			me [data-options] { border: 2px solid var(--sb-frame); }
			me [data-option] { align-items: center; color: var(--sb-text); display: grid; gap: 0.75rem; grid-template-columns: minmax(0, 1fr) auto; padding: 0.8125rem 0.875rem; text-decoration: none; }
			me [data-option] + [data-option] { border-top: 1px solid var(--sb-border); }
			me [data-option]:hover { background: var(--sb-hover); color: var(--sb-text); }
			me [data-option-title] { display: block; font-size: 0.9375rem; font-weight: 650; }
			me [data-option-description] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.35; margin-top: 0.125rem; }
			me [data-option-caret] { color: var(--sb-muted); }
			me [data-option]:hover [data-option-caret] { color: var(--sb-text); }
			me [data-selected] { border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); margin-bottom: 1.25rem; padding: 0.75rem; }
			me [data-caption] { background: var(--sb-accent); color: var(--sb-accent-text); display: block; font-size: 0.6875rem; font-weight: 750; letter-spacing: 0.08em; margin-bottom: 0.5rem; padding: 0.125rem 0.375rem; text-transform: uppercase; width: max-content; }
			me [data-selected] p { margin-bottom: 0; }
			me [data-field] { margin-bottom: 1rem; }
			me [data-field] > .form-label { font-size: 0.875rem; font-weight: 650; }
			me .form-control { background-color: var(--sb-input); border-color: var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-text); }
			me .form-control:focus { background-color: var(--sb-input); border-color: var(--sb-accent); box-shadow: none; color: var(--sb-text); }
			me .form-control.is-invalid, me .form-control.is-invalid:focus { border-color: var(--sb-danger); box-shadow: none; }
			me .form-check-input { background-color: var(--sb-input); border-color: var(--sb-control-border); border-radius: var(--sb-radius-control); }
			me .form-check-input[type="checkbox"] { border-radius: var(--sb-radius-control); }
			me .form-check-input:checked { background-color: var(--sb-accent); border-color: var(--sb-frame); }
			me .form-check-input:checked[type="checkbox"] { --bs-form-check-bg-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%231c1c16' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e"); }
			me .form-check-input:focus { border-color: var(--sb-accent); box-shadow: none; }
			me .form-control:focus-visible, me .form-check-input:focus-visible { box-shadow: none; outline: 2px solid var(--sb-focus); outline-offset: 2px; }
			me [data-save-template] { align-items: flex-start; border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-frame); cursor: pointer; display: flex; gap: 0.625rem; padding: 0.625rem 0.75rem; }
			me [data-save-template] .form-check-input { flex: 0 0 auto; margin: 0.2rem 0 0; }
			me [data-save-template-copy] { display: block; }
			me [data-save-template-title] { display: block; font-size: 0.875rem; font-weight: 600; }
			me [data-save-template-help] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.35; margin-top: 0.125rem; }
			me .invalid-feedback { color: var(--sb-danger); }
			me .invalid-feedback[data-visible] { display: block; }
			me [data-actions] { border-top: 1px solid var(--sb-border); display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.25rem; padding-top: 1rem; }
			me [data-primary-action] { gap: 0.375rem; }
			me [data-unavailable] { margin-bottom: 0; }
			me [data-unavailable] p { margin-bottom: 0; }
			@media sm- {
				me [data-panel-header] { padding-inline: 0.875rem; }
				me [data-panel-body] { padding: 0.875rem; }
			}
		</style>
		if backHref != "" {
			<a
				data-back
				href={ backHref }
				hx-get={ backHref }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@viewicons.ArrowLeft()
				<span>{ backLabel }</span>
			</a>
		}
		{ children... }
	</section>
}

templ creationSource(model choreviewmodels.Creation) {
	<div data-panel>
		<header data-panel-header>
			<h1 id="create-chore-heading">Add chore</h1>
		</header>
		<div data-panel-body>
			<p>Choose how to define this chore.</p>
			if model.HasSourceOptions() {
				<div data-options>
					if model.SpecifyNewHref != "" {
						@creationOption(oneOffCreationHref(model.SpecifyNewHref), "Create from scratch", "Enter a name, description, and deadline.")
					}
					if model.SelectTemplateHref != "" {
						@creationOption(model.SelectTemplateHref, "Use a template", "Start with a reusable chore definition.")
					}
				</div>
			} else {
				<div class="alert alert-danger" data-unavailable role="alert">No creation source is available.</div>
			}
		</div>
	</div>
}

templ creationRecurrence(model choreviewmodels.Creation) {
	<div data-panel>
		<header data-panel-header>
			<h1 id="create-chore-heading">Add chore</h1>
		</header>
		<div data-panel-body>
			if model.Creation.Template != nil {
				<div data-selected>
					<div data-caption>Selected template</div>
					<strong>{ model.Creation.Template.Name }</strong>
					if model.Creation.Template.Description != "" {
						<p>{ model.Creation.Template.Description }</p>
					}
				</div>
			}
			if model.OneOffHref != "" {
				<div data-options>
					@creationOption(model.OneOffHref, "Continue", "Set the deadline and add this chore.")
				</div>
			} else {
				<div class="alert alert-danger" data-unavailable role="alert">Chore creation is not available.</div>
			}
		</div>
	</div>
}

templ creationOption(href string, label string, description string) {
	<a
		data-option
		href={ href }
		hx-get={ href }
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url="true"
	>
		<span>
			<span data-option-title>{ label }</span>
			<span data-option-description>{ description }</span>
		</span>
		<span data-option-caret>@viewicons.CaretRight()</span>
	</a>
}

package chores

import (
	"fmt"
	"github.com/bpsoos/shiftbell/internal/models"
	"time"
)

templ table(offset int, limit int, result *models.GetChoreBatchResult) {
	<div
		id="chores-table-container"
		hx-get={ getBatchUrlWithQuery(offset, limit, "table") }
		hx-push-url={ getBatchUrlWithQuery(offset, limit, "all") }
		hx-trigger="load-chores from:body delay:1s"
		hx-swap="outerHTML"
		style="min-width: fit-content"
	>
		<table class="table table-striped">
			<style>
				me tr.htmx-swapping {
					opacity: 0;
					transition: opacity 1s ease-out;
				}
			</style>
			<thead>
				<tr>
					<th scope="col" style="width: 3%">#</th>
					<th scope="col" style="width: 50%">description</th>
					<th scope="col" style="width: 15%">deadline</th>
					<th class="text-center" scope="col" style="width: 10%">interval days</th>
					<th class="text-center" scope="col" style="width: 15%">last completed at</th>
					<th class="text-center" scope="col" style="width: 5%">mark complete</th>
				</tr>
			</thead>
			for _, chore := range result.Chores {
				<tr>
					<td>{ chore.Id }</td>
					<td>{ chore.Description }</td>
					<td class={ getRowClass(chore.Deadline) }>{ chore.Deadline.Format("2006-01-02") }</td>
					<td class="text-center">{ fmt.Sprintf("%d", chore.IntervalDays) }</td>
					<td class="text-center">{ chore.LastCompletedAt.Format("2006-01-02") }</td>
					<td class="text-center">
						@markCompleteButton(chore)
					</td>
				</tr>
			}
		</table>
		<div class="my-2 px-3">
			<div class="row">
				<button
					type="button"
					class="col text-center btn btn-secondary"
					hx-get={ getBatchUrlWithQuery(offset-limit, limit, "table") }
					hx-push-url={ getBatchUrlWithQuery(offset-limit, limit, "all") }
					hx-target="#chores-table-container"
					if offset == 0 {
						disabled
					}
				>
					←
				</button>
				<div class="col-8"></div>
				<button
					type="button"
					class="col text-center btn btn-secondary"
					hx-get={ getBatchUrlWithQuery(offset+limit, limit, "table") }
					hx-push-url={ getBatchUrlWithQuery(offset+limit, limit, "all") }
					hx-target="#chores-table-container"
					if !result.More {
						disabled
					}
				>
					→
				</button>
			</div>
		</div>
	</div>
}

templ markCompleteButton(chore models.Chore) {
	<form
		hx-patch={ fmt.Sprintf("/chores/%d", chore.Id) }
		hx-swap="outerHTML swap:1s"
		hx-target="closest tr"
	>
		<input type="hidden" value="complete" name="status" id="status"/>
		<button type="submit" class="btn btn-success btn-xs">
			<style>
			me {
				margin-top: 0;
				margin-bottom: 0;
				padding-top: 0rem;
				padding-bottom: 0rem;
				padding-left: 1.5rem;
				padding-right: 1.5rem;
			}
		</style>
			✓
		</button>
	</form>
}

func getRowClass(deadline time.Time) string {
	now := time.Now()
	if deadline.Before(now) || deadline.Sub(now) <= 24*time.Hour {
		return "text-bg-danger"
	}
	if deadline.Sub(now) > 24*time.Hour && deadline.Sub(now) <= 7*24*time.Hour {
		return "text-bg-warning"
	}
	return ""
}

func getBatchUrlWithQuery(offset int, limit int, content string) string {
	return fmt.Sprintf("/chores?status=incomplete&offset=%d&limit=%d&content=%s", offset, limit, content)
}

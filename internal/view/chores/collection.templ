package chores

import (
	"time"

	choreapimodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	choremodels "github.com/bpsoos/shiftbell/internal/models/chores"
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	collectioncontrols "github.com/bpsoos/shiftbell/internal/view/collectioncontrols"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ collectionContent(t *Templater, model choreviewmodels.Collection, today time.Time) {
	<section
		data-chore-collection
		aria-labelledby="chores-heading"
		hx-get={ model.Links.Href("self") }
		hx-trigger="choreCompleted from:body"
		hx-target="#main"
		hx-swap="outerHTML"
	>
		<style>
			me { margin-block-start: -0.5rem; margin-inline: auto; max-width: 52rem; }
			@media xs- {
				me { margin-block-start: -0.75rem; }
			}
		</style>
		@collectionHeader(model)
		if model.Notice != "" {
			@collectionNotice(model.Notice)
		}
		if model.SearchOpen {
			@choreSearch(model)
		} else {
			@choreCollectionUtilities(model)
		}
		if len(model.Items) == 0 {
			@collectionEmptyState(model)
		} else {
			@choreResults(t, model, today)
		}
		@collectionPagination(model)
	</section>
}

templ collectionHeader(model choreviewmodels.Collection) {
	<header>
		<style>
			me { align-items: flex-end; display: flex; gap: 0.75rem; justify-content: space-between; margin-bottom: 0.75rem; }
			me > h1 { font-size: 1.875rem; letter-spacing: -0.035em; line-height: 1; margin: 0; }
			me > h1::after { background: var(--sb-accent); content: ""; display: block; height: 3px; margin-top: 0.5rem; width: 2rem; }
			me > .btn { gap: 0.375rem; }
			@media sm- {
				me > h1 { font-size: 1.625rem; }
				me > .btn { font-size: 0.875rem; padding: 0.375rem 0.625rem; }
			}
		</style>
		if model.Status == choremodels.ChoreStatusCompleted {
			<style>
				me { margin-bottom: 1.25rem; }
			</style>
		}
		<h1 id="chores-heading">
			if model.Status == choremodels.ChoreStatusCompleted {
				Completed chores
			} else {
				Chores
			}
		</h1>
		<a
			class="btn btn-primary"
			href={ model.CreateHref }
			hx-get={ model.CreateHref }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			@viewicons.Plus()
			<span>Add chore</span>
		</a>
	</header>
}

templ collectionNotice(notice string) {
	<div role="status">
		<style>
			me { align-items: center; background: var(--sb-surface); border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-text); display: flex; font-size: 0.875rem; gap: 0.5rem; margin-bottom: 0.875rem; padding: 0.625rem 0.75rem; }
			me > svg { color: var(--sb-muted); flex: 0 0 auto; }
		</style>
		@viewicons.CheckCircle()
		<span>{ notice }</span>
	</div>
}

templ choreCollectionUtilities(model choreviewmodels.Collection) {
	<nav aria-label="Chore collection">
		<style>
			me { align-items: center; display: flex; gap: 0.75rem; justify-content: flex-end; line-height: 1; margin: 0 0 0.5rem; min-height: 1.5rem; }
			me > [data-utility-link] { color: var(--sb-muted); font-size: 0.75rem; font-weight: 500; text-decoration: none; }
			me > [data-utility-link]:hover, me > [data-utility-link]:focus-visible { color: var(--sb-text); text-decoration: underline; text-underline-offset: 0.15em; }
			me > [data-search-toggle] { align-items: center; background: transparent; border: 0; color: var(--sb-muted); display: inline-flex; height: 1.5rem; justify-content: center; padding: 0.125rem; text-decoration: none; width: 1.5rem; }
			me > [data-search-toggle]:hover, me > [data-search-toggle]:focus-visible { color: var(--sb-text); }
		</style>
		if model.Status == choremodels.ChoreStatusCompleted {
			<a
				data-utility-link
				href="/chores"
				hx-get="/chores"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>Back to chores</a>
		} else {
			<a
				data-utility-link
				href="/chores?status=completed"
				hx-get="/chores?status=completed"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>View completed</a>
		}
		<a
			data-search-toggle
			href={ choreSearchHref(model.Status) }
			hx-get={ choreSearchHref(model.Status) }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
			aria-label={ choreSearchPlaceholder(model.Status) }
			title={ choreSearchPlaceholder(model.Status) }
		>
			@viewicons.MagnifyingGlass()
			<span class="visually-hidden">Search</span>
		</a>
	</nav>
}

templ choreSearch(model choreviewmodels.Collection) {
	<form
		action="/chores"
		method="get"
		hx-get="/chores"
		hx-trigger="submit, input changed delay:275ms target:input[name='search']"
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
	>
		<style>
			me { align-items: center; display: flex; gap: 0.75rem; margin: 0 0 0.5rem; }
			me > a { color: var(--sb-muted); flex: 0 0 auto; font-size: 0.8125rem; font-weight: 600; line-height: 1; }
			me > a:hover, me > a:focus-visible { color: var(--sb-text); }
		</style>
		if model.Status == choremodels.ChoreStatusCompleted {
			<input type="hidden" name="status" value="completed"/>
		}
		@collectioncontrols.SearchField(
			"chore-collection-search",
			model.Search,
			choreSearchPlaceholder(model.Status),
			model.AutofocusSearch,
		)
		<a
			href={ choreCollectionViewHref(model.Status) }
			hx-get={ choreCollectionViewHref(model.Status) }
			hx-target="#main"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-sync="closest form:replace"
		>Close</a>
	</form>
}

templ choreResults(t *Templater, model choreviewmodels.Collection, today time.Time) {
	<div>
		@choreResultsStructureStyles()
		@choreCompletionStyles()
		@choreRowStyles()
		if model.Status == choremodels.ChoreStatusCompleted {
			@choreList(t, model.Items, today)
		} else {
			for _, group := range t.deadlineGroups(model.Items, today) {
				@choreGroup(t, group, today)
			}
		}
	</div>
}

templ choreResultsStructureStyles() {
	<style>
		me { background: var(--sb-surface); border: 2px solid var(--sb-frame); }
		me > section + section { border-top: 2px solid var(--sb-frame); }
		me > section > h2 { align-items: center; background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-muted-strong); display: flex; font-size: 0.6875rem; font-weight: 750; gap: 0.375rem; letter-spacing: 0.1em; margin: 0; padding: 0.45rem 0.75rem; text-transform: uppercase; }
		me > section[data-group-state="overdue"] > h2 { border-left-color: var(--sb-danger); color: var(--sb-danger); }
		me > ul, me > section > ul { list-style: none; margin: 0; padding: 0; }
		me ul > li { display: flex; }
		me ul > li + li { border-top: 1px solid var(--sb-border); }
	</style>
}

templ choreCompletionStyles() {
	<style>
		me [data-complete-chore] { align-items: center; align-self: stretch; background: color-mix(in srgb, var(--sb-accent) 7%, transparent); border: 0; border-right: 1px solid var(--sb-border); color: var(--sb-focus); display: flex; flex: 0 0 4rem; justify-content: center; min-height: 44px; min-width: 4rem; padding: 0; }
		me [data-complete-chore]:hover, me [data-complete-chore]:focus-visible, me [data-complete-chore].htmx-request, me [data-complete-chore][data-completion-pending] { background: color-mix(in srgb, var(--sb-accent) 18%, transparent); }
		me [data-complete-icon] { align-items: center; display: flex; height: 1.5rem; justify-content: center; transition: transform 80ms ease; width: 1.5rem; }
		me [data-complete-icon] svg { height: 1.45rem; width: 1.45rem; }
		me [data-complete-icon="idle"] svg { stroke: currentColor; stroke-width: 6px; }
		me [data-complete-icon="preview"] { background: var(--sb-accent); border-radius: 50%; color: var(--sb-accent-text); display: none; }
		me [data-complete-chore]:hover [data-complete-icon="idle"], me [data-complete-chore]:focus-visible [data-complete-icon="idle"], me [data-complete-chore].htmx-request [data-complete-icon="idle"], me [data-complete-chore][data-completion-pending] [data-complete-icon="idle"] { display: none; }
		me [data-complete-chore]:hover [data-complete-icon="preview"], me [data-complete-chore]:focus-visible [data-complete-icon="preview"], me [data-complete-chore].htmx-request [data-complete-icon="preview"], me [data-complete-chore][data-completion-pending] [data-complete-icon="preview"] { display: flex; }
		me [data-complete-chore]:active [data-complete-icon] { transform: translateY(2px); }
	</style>
}

templ choreRowStyles() {
	<style>
		me [data-chore-detail] { align-items: center; color: var(--sb-text); display: flex; flex: 1 1 auto; gap: 0.75rem; min-height: 4rem; min-width: 0; padding: 0.6875rem 0.875rem; text-decoration: none; }
		me a[data-chore-detail]:hover { background: var(--sb-hover); color: var(--sb-text); }
		me [data-chore-copy] { flex: 1 1 auto; min-width: 0; }
		me [data-chore-name] { display: block; font-size: 0.9375rem; font-weight: 650; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		me [data-chore-description] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.3; margin-top: 0.125rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		me [data-chore-detail] > time { color: var(--sb-muted); flex: 0 0 auto; font-size: 0.8125rem; font-variant-numeric: tabular-nums; text-align: right; }
		me [data-chore-detail] > time[data-deadline-state="overdue"] { color: var(--sb-danger); }
		me [data-chore-detail] > time[data-deadline-state="today"] { color: var(--sb-warning); }
		me [data-row-caret] { color: var(--sb-muted); flex: 0 0 auto; opacity: 0.5; }
		me a[data-chore-detail]:hover [data-row-caret] { color: var(--sb-text); opacity: 1; }
		@media sm- {
			me [data-chore-description] { display: none; }
			me [data-chore-detail] { gap: 0.5rem; min-height: 3.625rem; padding-inline: 0.75rem; }
		}
	</style>
}

templ choreGroup(t *Templater, group deadlineGroup, today time.Time) {
	<section data-group-state={ group.State } aria-labelledby={ "chore-group-" + group.State }>
		<h2 id={ "chore-group-" + group.State }>
			if group.State == "overdue" {
				@viewicons.WarningCircle()
			}
			{ group.Label }
		</h2>
		@choreList(t, group.Chores, today)
	</section>
}

templ choreList(t *Templater, chores []choreviewmodels.CollectionItem, today time.Time) {
	<ul>
		for _, chore := range chores {
			@choreSummary(t, chore, today)
		}
	</ul>
}

templ choreSummary(t *Templater, item choreviewmodels.CollectionItem, today time.Time) {
	<li>
		if item.CompleteHref != "" {
			<button
				type="button"
				data-complete-chore
				hx-get={ item.CompleteHref }
				hx-target="#dialog-root"
				hx-swap="innerHTML"
				aria-haspopup="dialog"
				aria-label={ "Complete \u201c" + item.Chore.Name + "\u201d" }
				title={ "Complete \u201c" + item.Chore.Name + "\u201d" }
			>
				<span data-complete-icon="idle">@viewicons.Circle()</span>
				<span data-complete-icon="preview">@viewicons.CheckCircle()</span>
			</button>
		}
		if href := item.Chore.Links.Href("self"); href != "" {
			<a
				data-chore-detail
				href={ href }
				hx-get={ href }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@choreSummaryContent(t, item.Chore, today)
			</a>
		} else {
			<div data-chore-detail>
				@choreSummaryContent(t, item.Chore, today)
			</div>
		}
	</li>
}

templ choreSummaryContent(t *Templater, chore choreapimodels.Response, today time.Time) {
	<span data-chore-copy>
		<span data-chore-name>{ chore.Name }</span>
		if chore.Description != "" {
			<span data-chore-description>{ chore.Description }</span>
		}
	</span>
	if chore.Status == choremodels.ChoreStatusCompleted && chore.CompletedOn != nil {
		<time datetime={ *chore.CompletedOn }>{ "Completed " + *chore.CompletedOn }</time>
	} else {
		<time
			data-deadline-state={ t.deadlineState(chore.Deadline, today) }
			datetime={ chore.Deadline }
			aria-label={ t.deadlineAccessibleLabel(chore.Deadline) }
			title={ t.deadlineAccessibleLabel(chore.Deadline) }
		>{ t.relativeDeadline(chore.Deadline, today) }</time>
	}
	<span data-row-caret>@viewicons.CaretRight()</span>
}

templ collectionEmptyState(model choreviewmodels.Collection) {
	<div>
		<style>
			me { align-items: center; background: var(--sb-surface); border: 2px solid var(--sb-frame); display: flex; gap: 0.875rem; padding: 1.5rem; }
			me > svg { color: var(--sb-muted); height: 1.5rem; width: 1.5rem; }
			me h2 { font-size: 1rem; margin: 0 0 0.125rem; }
			me p { color: var(--sb-muted); font-size: 0.875rem; margin: 0; }
		</style>
		@viewicons.CheckCircle()
		<div>
			if model.Search != "" {
				<h2>No matching chores</h2>
				<p>Try a different search.</p>
			} else if model.Status == choremodels.ChoreStatusCompleted {
				<h2>No completed chores</h2>
				<p>Completed chores will appear here.</p>
			} else {
				<h2>No chores due</h2>
				<p>Create a chore to get started.</p>
			}
		</div>
	</div>
}

templ collectionPagination(model choreviewmodels.Collection) {
	if model.HasPagination() {
		<nav aria-label="Chore pages">
			<style>
				me { display: flex; gap: 0.75rem; margin-top: 1rem; }
				me > a { gap: 0.375rem; }
				me > a[rel="next"] { margin-left: auto; }
			</style>
			if previousHref := model.Links.Href("previous"); previousHref != "" {
				<a
					class="btn btn-outline-secondary"
					href={ previousHref }
					hx-get={ previousHref }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					rel="prev"
				>
					@viewicons.CaretLeft()
					<span>Previous</span>
				</a>
			}
			if nextHref := model.Links.Href("next"); nextHref != "" {
				<a
					class="btn btn-outline-secondary"
					href={ nextHref }
					hx-get={ nextHref }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					rel="next"
				>
					<span>Next</span>
					@viewicons.CaretRight()
				</a>
			}
		</nav>
	}
}

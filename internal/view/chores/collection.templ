package chores

import (
	"time"

	choreapimodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ collectionContent(t *Templater, model choreviewmodels.Collection, today time.Time) {
	<section aria-labelledby="chores-heading">
		<style>
			me { margin-inline: auto; max-width: 52rem; }
			me > [data-page-header] { align-items: flex-end; display: flex; gap: 1rem; justify-content: space-between; margin-bottom: 1rem; }
			me > [data-page-header] h1 { font-size: 1.875rem; letter-spacing: -0.035em; line-height: 1; margin: 0; }
			me > [data-page-header] h1::after { background: var(--sb-accent); content: ""; display: block; height: 3px; margin-top: 0.5rem; width: 2rem; }
			me [data-primary-action] { gap: 0.375rem; }
			me [data-notice] { align-items: center; background: var(--sb-surface); border: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-text); display: flex; font-size: 0.875rem; gap: 0.5rem; margin-bottom: 0.875rem; padding: 0.625rem 0.75rem; }
			me [data-notice] svg { color: var(--sb-muted); flex: 0 0 auto; }
			me [data-chore-groups] { background: var(--sb-surface); border: 2px solid var(--sb-frame); }
			me [data-chore-group] + [data-chore-group] { border-top: 2px solid var(--sb-frame); }
			me [data-group-heading] { align-items: center; background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); color: var(--sb-muted-strong); display: flex; font-size: 0.6875rem; font-weight: 750; gap: 0.375rem; letter-spacing: 0.1em; margin: 0; padding: 0.45rem 0.75rem; text-transform: uppercase; }
			me [data-group-state="overdue"] [data-group-heading] { border-left-color: var(--sb-danger); color: var(--sb-danger); }
			me [data-chore-list] { list-style: none; margin: 0; padding: 0; }
			me [data-chore-row] { display: flex; }
			me [data-chore-row] + [data-chore-row] { border-top: 1px solid var(--sb-border); }
			me [data-chore-detail] { align-items: center; color: var(--sb-text); display: flex; flex: 1 1 auto; gap: 0.75rem; min-height: 4rem; min-width: 0; padding: 0.6875rem 0.875rem; text-decoration: none; }
			me a[data-chore-detail]:hover { background: var(--sb-hover); color: var(--sb-text); }
			me [data-chore-copy] { flex: 1 1 auto; min-width: 0; }
			me [data-chore-name] { display: block; font-size: 0.9375rem; font-weight: 650; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			me [data-chore-description] { color: var(--sb-muted); display: block; font-size: 0.8125rem; line-height: 1.3; margin-top: 0.125rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			me [data-deadline] { color: var(--sb-muted); flex: 0 0 auto; font-size: 0.8125rem; font-variant-numeric: tabular-nums; text-align: right; }
			me [data-deadline-state="overdue"] { color: var(--sb-danger); }
			me [data-deadline-state="today"] { color: var(--sb-warning); }
			me [data-row-caret] { color: var(--sb-muted); flex: 0 0 auto; opacity: 0.5; }
			me a[data-chore-detail]:hover [data-row-caret] { color: var(--sb-text); opacity: 1; }
			me [data-empty] { align-items: center; background: var(--sb-surface); border: 2px solid var(--sb-frame); display: flex; gap: 0.875rem; padding: 1.5rem; }
			me [data-empty] > svg { color: var(--sb-muted); height: 1.5rem; width: 1.5rem; }
			me [data-empty] h2 { font-size: 1rem; margin: 0 0 0.125rem; }
			me [data-empty] p { color: var(--sb-muted); font-size: 0.875rem; margin: 0; }
			me [data-pagination] { display: flex; gap: 0.75rem; margin-top: 1rem; }
			me [data-page-link] { gap: 0.375rem; }
			me [data-page-link="next"] { margin-left: auto; }
			@media sm- {
				me > [data-page-header] h1 { font-size: 1.625rem; }
				me [data-primary-action] { font-size: 0.875rem; padding: 0.375rem 0.625rem; }
				me [data-chore-description] { display: none; }
				me [data-chore-detail] { gap: 0.5rem; min-height: 3.625rem; padding-inline: 0.75rem; }
			}
		</style>
		<header data-page-header>
			<h1 id="chores-heading">Chores</h1>
			if href := model.Collection.Actions.Href("create"); href != "" {
				<a
					class="btn btn-primary"
					data-primary-action
					href={ href }
					hx-get={ href }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
				>
					@viewicons.Plus()
					<span>Add chore</span>
				</a>
			}
		</header>
		if model.Notice != "" {
			<div data-notice role="status">
				@viewicons.CheckCircle()
				<span>{ model.Notice }</span>
			</div>
		}
		if len(model.Collection.Items) == 0 {
			@collectionEmptyState(model)
		} else {
			<div data-chore-groups>
				for _, group := range t.deadlineGroups(model.Collection.Items, today) {
					<section data-chore-group data-group-state={ group.State } aria-labelledby={ "chore-group-" + group.State }>
						<h2 id={ "chore-group-" + group.State } data-group-heading>
							if group.State == "overdue" {
								@viewicons.WarningCircle()
							}
							{ group.Label }
						</h2>
						<ul data-chore-list>
							for _, chore := range group.Chores {
								@choreSummary(t, chore, today)
							}
						</ul>
					</section>
				}
			</div>
		}
		@collectionPagination(model)
	</section>
}

templ choreSummary(t *Templater, chore choreapimodels.Response, today time.Time) {
	<li data-chore-row>
		if href := chore.Links.Href("self"); href != "" {
			<a
				data-chore-detail
				href={ href }
				hx-get={ href }
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@choreSummaryContent(t, chore, today)
			</a>
		} else {
			<div data-chore-detail>
				@choreSummaryContent(t, chore, today)
			</div>
		}
	</li>
}

templ choreSummaryContent(t *Templater, chore choreapimodels.Response, today time.Time) {
	<span data-chore-copy>
		<span data-chore-name>{ chore.Name }</span>
		if chore.Description != "" {
			<span data-chore-description>{ chore.Description }</span>
		}
	</span>
	<time
		data-deadline
		data-deadline-state={ t.deadlineState(chore.Deadline, today) }
		datetime={ chore.Deadline }
		aria-label={ t.deadlineAccessibleLabel(chore.Deadline) }
		title={ t.deadlineAccessibleLabel(chore.Deadline) }
	>{ t.relativeDeadline(chore.Deadline, today) }</time>
	<span data-row-caret>@viewicons.CaretRight()</span>
}

templ collectionEmptyState(model choreviewmodels.Collection) {
	<div data-empty>
		@viewicons.CheckCircle()
		<div>
			<h2>No chores due</h2>
			<p>Create a chore to get started.</p>
		</div>
	</div>
}

templ collectionPagination(model choreviewmodels.Collection) {
	if model.HasPagination() {
		<nav data-pagination aria-label="Chore pages">
			if previousHref := model.Collection.Links.Href("previous"); previousHref != "" {
				<a
					class="btn btn-outline-secondary"
					data-page-link="previous"
					href={ previousHref }
					hx-get={ previousHref }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					rel="prev"
				>
					@viewicons.CaretLeft()
					<span>Previous</span>
				</a>
			}
			if nextHref := model.Collection.Links.Href("next"); nextHref != "" {
				<a
					class="btn btn-outline-secondary"
					data-page-link="next"
					href={ nextHref }
					hx-get={ nextHref }
					hx-target="#main"
					hx-swap="outerHTML"
					hx-push-url="true"
					rel="next"
				>
					<span>Next</span>
					@viewicons.CaretRight()
				</a>
			}
		</nav>
	}
}

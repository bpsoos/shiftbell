package chores

import (
	choreapimodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	profileview "github.com/bpsoos/shiftbell/internal/view/profiles"
)

templ choreOwner(id *int, name string) {
	<span data-chore-owner>
		<style>
			me {
				align-items: center;
				color: var(--sb-muted);
				display: inline-flex;
				font-size: 0.8125rem;
				gap: 0.375rem;
				max-width: 100%;
				vertical-align: middle;
			}
			me > img {
				border: 1px solid var(--sb-avatar-border);
				flex: 0 0 1.25rem;
				height: 1.25rem;
				object-fit: cover;
				width: 1.25rem;
			}
			me > span {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
		</style>
		if id != nil {
			<img src={ profileview.AvatarHref(*id) } alt="" width="20" height="20"/>
			<span title={ name }><span class="visually-hidden">Owner: </span>{ name }</span>
		} else {
			<span>Unassigned</span>
		}
	</span>
}

templ choreAssignment(chore choreapimodels.Representation) {
	<div data-chore-assignment>
		<style>
			me {
				align-items: center;
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				gap: 0.625rem;
			}
			me > [data-label] {
				color: var(--sb-muted);
				font-size: 0.8125rem;
			}
			me > .dropdown {
				max-width: 100%;
				min-width: 0;
			}
			me [data-owner-toggle] {
				align-items: center;
				background: transparent;
				border: 1px solid transparent;
				color: var(--sb-muted);
				display: flex;
				gap: 0.5rem;
				max-width: 100%;
				padding: 0.25rem 0.375rem;
			}
			me [data-owner-toggle]:hover,
			me [data-owner-toggle][aria-expanded="true"] {
				background: var(--sb-hover);
				border-color: var(--sb-border);
			}
			me [data-owner-toggle]::after {
				border-bottom: 1px solid currentColor;
				border-right: 1px solid currentColor;
				content: "";
				flex: 0 0 0.375rem;
				height: 0.375rem;
				margin: -0.1875rem 0.125rem 0;
				transform: rotate(45deg);
				width: 0.375rem;
			}
			me [data-owner-toggle] > [data-chore-owner] {
				color: #242420;
				font-weight: 500;
				min-width: 0;
			}
			[data-bs-theme="dark"] me [data-owner-toggle] > [data-chore-owner] {
				color: var(--sb-text);
			}
			me [data-owner-toggle] > [data-chore-owner] > img {
				flex-basis: 24px;
				height: 24px;
				width: 24px;
			}
			me .dropdown-menu {
				background: var(--sb-surface);
				border: 1px solid var(--sb-frame);
				border-radius: 0;
				box-shadow: none;
				max-height: min(24rem, calc(100dvh - 6rem));
				min-width: 0;
				overflow-y: auto;
				padding: 0.375rem;
				width: min(14rem, calc(100vw - 2rem));
			}
			me [data-loading] {
				color: var(--sb-muted);
				font-size: 0.8125rem;
				margin: 0;
				padding: 0.5rem;
			}
			@media xs- {
				me {
					gap: 0.125rem;
					grid-template-columns: minmax(0, 1fr);
					justify-items: end;
				}
			}
		</style>
		<span data-label>Owner</span>
		if href := chore.Actions.Href("set_assignment"); href != "" {
			<div class="dropdown">
				<button type="button" data-owner-toggle data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Change owner" hx-get={ href } hx-trigger="show.bs.dropdown" hx-target="next .dropdown-menu" hx-swap="innerHTML">
					@choreOwner(chore.OwnerProfileId, chore.OwnerProfileName)
				</button>
				<div class="dropdown-menu dropdown-menu-end" aria-label="Assign profile">
					<p data-loading role="status">Loading profiles…</p>
				</div>
			</div>
		} else {
			@choreOwner(chore.OwnerProfileId, chore.OwnerProfileName)
		}
	</div>
}

package chores

import (
	choreviewmodels "github.com/bpsoos/shiftbell/internal/models/view/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ completionDialog(model choreviewmodels.CompletionDialog) {
	<dialog data-completion-dialog aria-labelledby="completion-dialog-heading">
		<style>
			me { background: var(--sb-surface); border: 2px solid var(--sb-frame); border-radius: var(--sb-radius-overlay); box-shadow: 5px 5px 0 var(--sb-depth); color: var(--sb-text); max-height: calc(100dvh - 2rem); max-width: calc(100% - 2rem); overflow: auto; padding: 0; width: 30rem; }
			me::backdrop { background: rgb(0 0 0 / 0.58); }
			me [data-dialog-header] { background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); padding: 0.875rem 1rem; }
			me [data-dialog-header] h2 { font-size: 1.125rem; letter-spacing: -0.015em; margin: 0; }
			me [data-dialog-body] { padding: 1rem; }
			me [data-dialog-prompt] { color: var(--sb-muted); line-height: 1.45; margin: 0 0 1rem; }
			me [data-dialog-prompt] strong { color: var(--sb-text); }
			me [data-field] { margin: 0; }
			me .form-label { font-size: 0.875rem; font-weight: 650; }
			me .form-control { background-color: var(--sb-input); border-color: var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-text); }
			me .form-control:focus { background-color: var(--sb-input); border-color: var(--sb-accent); box-shadow: none; color: var(--sb-text); }
			me .form-control.is-invalid, me .form-control.is-invalid:focus { border-color: var(--sb-danger); box-shadow: none; }
			me .invalid-feedback { color: var(--sb-danger); }
			me .invalid-feedback[data-visible] { display: block; }
			me [data-dialog-actions] { border-top: 1px solid var(--sb-border); display: flex; gap: 0.75rem; justify-content: flex-end; padding: 0.875rem 1rem 1rem; }
			me [data-dialog-actions] .btn { min-height: 44px; }
			me [data-complete-action] { gap: 0.375rem; }
			@media xs- {
				me { border-bottom: 0; border-radius: var(--sb-radius-overlay) var(--sb-radius-overlay) 0 0; box-shadow: 0 -4px 0 var(--sb-depth); margin: auto 0 0; max-height: calc(100dvh - 1rem); max-width: none; width: 100%; }
				me [data-dialog-actions] .btn { flex: 1 1 0; }
			}
		</style>
		<form
			action={ model.ActionHref }
			method="post"
			hx-put={ model.ActionHref }
			hx-target="#dialog-root"
			hx-swap="innerHTML"
		>
			<header data-dialog-header>
				<h2 id="completion-dialog-heading">Complete chore</h2>
			</header>
			<div data-dialog-body>
				<p data-dialog-prompt>Mark <strong>{ model.Name }</strong> as completed.</p>
				<div data-field>
					<label class="form-label" for="completion-completed-on">Completed on</label>
					<input
						class={ formControlClass("form-control", model.CompletedOn.Error) }
						type="date"
						id="completion-completed-on"
						name="completed_on"
						value={ model.CompletedOn.Value }
						max={ model.CompletedOnMax }
						if model.CompletedOn.Error != "" {
							aria-describedby="completion-completed-on-error"
							aria-invalid="true"
						}
						required
					/>
					@fieldFeedback("completion-completed-on-error", model.CompletedOn.Error)
				</div>
			</div>
			<footer data-dialog-actions>
				<button class="btn btn-secondary" type="button" data-dialog-cancel>Cancel</button>
				<button class="btn btn-primary" type="submit" data-complete-action>
					@viewicons.CheckCircle()
					<span>Complete chore</span>
				</button>
			</footer>
		</form>
	</dialog>
}

package chores

import (
	choremodels "github.com/bpsoos/shiftbell/internal/models/api/chores"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ choreCompletion(t *Templater, chore choremodels.Representation) {
	<div data-completion>
		<style>
			me {
				border-top: 1px solid var(--sb-border);
				margin-top: 1rem;
				padding-top: 0.875rem;
			}
			me > [data-completion-line] {
				align-items: baseline;
				display: flex;
				flex-wrap: wrap;
				font-size: 0.9375rem;
				gap: 0.25rem 0.375rem;
				margin: 0 0 0.375rem;
			}
			me > [data-original-deadline] {
				color: var(--sb-muted);
				font-size: 0.8125rem;
				margin: 0;
			}
			me [data-correct-completion] {
				align-items: center;
				color: color-mix(in srgb, var(--sb-muted) 92%, var(--sb-surface));
				display: inline-flex;
				font-size: 0.8125rem;
				gap: 0.25rem;
				text-decoration: none;
				white-space: nowrap;
			}
			me [data-correct-completion]:hover,
			me [data-correct-completion]:focus-visible {
				color: var(--sb-text);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}
			me [data-correct-completion] > svg {
				color: inherit;
				height: 1rem;
				width: 1rem;
			}
		</style>
		<div data-completion-line>
			<span>Completed <time datetime={ *chore.CompletedOn }>{ t.exactDeadline(*chore.CompletedOn) }</time></span>
			if href := chore.Actions.Href("correct_completion"); href != "" {
				<a data-correct-completion href={ href + "/edit" } hx-get={ href + "/edit" } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
					@viewicons.PencilSimple()
					<span>Change date</span>
				</a>
			}
		</div>
		<p data-original-deadline>Was due on { t.exactDeadline(chore.Deadline) }</p>
	</div>
}

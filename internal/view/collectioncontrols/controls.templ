package collectioncontrols

import viewicons "github.com/bpsoos/shiftbell/internal/view/icons"

templ Bar(model Model) {
	<form
		action={ model.ActionHref }
		method="get"
		hx-get={ model.ActionHref }
		hx-trigger="submit, input changed delay:275ms target:input[name='search']"
		hx-target="#main"
		hx-swap="outerHTML"
		hx-push-url="true"
	>
		<style>
			me { align-items: center; display: flex; gap: 0.625rem; margin: 0.75rem 0 0; min-width: 0; }
		</style>
		for _, input := range model.HiddenInputs {
			<input type="hidden" name={ input.Name } value={ input.Value }/>
		}
		@SearchField(
			model.SearchInputID,
			model.Search,
			model.SearchPlaceholder,
			model.AutofocusSearch,
		)
	</form>
}

templ SearchField(inputID string, value string, placeholder string, autofocus bool) {
	<label>
		<style>
			me { display: block; flex: 1 1 12rem; margin: 0; min-width: 0; position: relative; }
			me > svg { color: var(--sb-muted); height: 1rem; left: 0.625rem; pointer-events: none; position: absolute; top: 50%; transform: translateY(-50%); width: 1rem; }
			me > input { background: var(--sb-input); border: 1px solid var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-text); font-size: 0.875rem; line-height: 1.25; min-height: 2.25rem; min-width: 0; padding: 0.4375rem 0.625rem 0.4375rem 2rem; width: 100%; }
			me > input::placeholder { color: var(--sb-muted); opacity: 1; }
			me > input:focus { border-color: var(--sb-accent); }
		</style>
		<span class="visually-hidden">{ placeholder }</span>
		@viewicons.MagnifyingGlass()
		<input
			type="search"
			id={ inputID }
			name="search"
			value={ value }
			placeholder={ placeholder }
			if autofocus {
				autofocus
			}
		/>
	</label>
}

package profiles

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/profiles"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ collection(model viewmodels.Collection) {
	<section aria-labelledby="profiles-heading">
		<style>
			me {
				margin-block-start: -0.5rem;
				margin-inline: auto;
				max-width: 52rem;
			}
			@media xs- {
				me {
					margin-block-start: -0.75rem;
				}
			}
		</style>
		<header>
			<style>
				me {
					align-items: flex-end;
					display: flex;
					gap: 1rem;
					justify-content: space-between;
					margin-bottom: 1rem;
				}
				me > h1 {
					font-size: 1.875rem;
					letter-spacing: -0.035em;
					line-height: 1;
					margin: 0;
				}
				me > h1::after {
					background: var(--sb-accent);
					content: "";
					display: block;
					height: 3px;
					margin-top: 0.5rem;
					width: 2rem;
				}
				@media sm- {
					me > h1 {
						font-size: 1.625rem;
					}
				}
			</style>
			<h1 id="profiles-heading">Profiles</h1>
			<a class="btn btn-primary" href={ model.CreateHref } hx-get={ model.CreateHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				<style>
					me {
						flex-shrink: 0;
						gap: 0.375rem;
					}
				</style>
				@viewicons.Plus()
				<span>New profile</span>
			</a>
		</header>
		if len(model.Profiles) == 0 {
			<div data-empty>
				<style>
					me {
						background: var(--sb-surface);
						border: 2px solid var(--sb-frame);
						padding: 2rem 1rem;
						text-align: center;
					}
				</style>
				<h2>
					<style>
						me {
							font-size: 1.125rem;
							margin-bottom: 0.5rem;
						}
					</style>
					No profiles yet
				</h2>
				<p>
					<style>
						me {
							color: var(--sb-muted);
							margin: 0;
						}
					</style>
					Create a profile to get started.
				</p>
			</div>
		} else {
			<ul aria-label="Profiles">
				<style>
					me {
						background: var(--sb-surface);
						border: 2px solid var(--sb-frame);
						list-style: none;
						margin: 0;
						padding: 0;
					}
					me > li {
						align-items: center;
						display: flex;
						gap: 0.875rem;
						min-height: 4.5rem;
						padding: 0.875rem 1rem;
					}
					me > li + li {
						border-top: 1px solid var(--sb-border);
					}
					me [data-profile-icon] {
						border: 1px solid var(--sb-avatar-border);
						flex: 0 0 2.5rem;
						height: 2.5rem;
						object-fit: cover;
						width: 2.5rem;
					}
					me [data-profile-name] {
						color: var(--sb-text);
						flex: 1;
						font-size: 1rem;
						font-weight: 650;
						min-width: 0;
						overflow-wrap: anywhere;
					}
					me [data-delete-profile] {
						flex-shrink: 0;
						gap: 0.375rem;
					}
					me [data-delete-profile]:hover,
					me [data-delete-profile]:focus-visible {
						background: color-mix(
							in srgb,
							var(--sb-danger) 10%,
							var(--sb-surface)
						);
						border-color: var(--sb-danger);
						color: var(--sb-danger);
					}
					@media sm- {
						me > li {
							padding: 0.75rem;
						}
					}
				</style>
				for _, profile := range model.Profiles {
					<li>
						<img data-profile-icon src={ AvatarHref(profile.Id) } alt="" width="40" height="40"/>
						<span data-profile-name>{ profile.Name }</span>
						if deleteHref := profile.Actions.Href("delete"); deleteHref != "" {
							<button
								class="btn btn-outline-secondary btn-sm"
								type="button"
								data-delete-profile
								aria-label={ "Delete " + profile.Name }
								hx-delete={ deleteHref }
								hx-confirm={ "Delete profile \"" + profile.Name + "\"?" }
								hx-target="#main"
								hx-swap="outerHTML"
								hx-disabled-elt="this"
							>
								@viewicons.Trash()
								<span>Delete</span>
							</button>
						}
					</li>
				}
			</ul>
		}
	</section>
}

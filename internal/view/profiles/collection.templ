package profiles

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/profiles"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ collection(model viewmodels.Collection) {
	<section aria-labelledby="profiles-heading">
		<style>
			me {
				margin-block-start: -0.5rem;
				margin-inline: auto;
				max-width: 52rem;
			}
			me > header {
				align-items: flex-end;
				display: flex;
				gap: 1rem;
				justify-content: space-between;
				margin-bottom: 1rem;
			}
			me h1 {
				font-size: 1.875rem;
				letter-spacing: -0.035em;
				line-height: 1;
				margin: 0;
			}
			me h1::after {
				background: var(--sb-accent);
				content: "";
				display: block;
				height: 3px;
				margin-top: 0.5rem;
				width: 2rem;
			}
			me > header .btn {
				flex-shrink: 0;
				gap: 0.375rem;
			}
			me > ul {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				list-style: none;
				margin: 0;
				padding: 0;
			}
			me > ul > li {
				align-items: center;
				display: flex;
				gap: 0.875rem;
				min-height: 4.5rem;
				padding: 0.875rem 1rem;
			}
			me > ul > li + li {
				border-top: 1px solid var(--sb-border);
			}
			me [data-profile-icon] {
				border: 1px solid var(--sb-avatar-border);
				flex: 0 0 2.5rem;
				height: 2.5rem;
				object-fit: cover;
				width: 2.5rem;
			}
			me [data-profile-name] {
				color: var(--sb-text);
				flex: 1;
				font-size: 1rem;
				font-weight: 650;
				min-width: 0;
				overflow-wrap: anywhere;
			}
			me [data-delete-profile] {
				flex-shrink: 0;
				gap: 0.375rem;
			}
			me [data-delete-profile]:hover,
			me [data-delete-profile]:focus-visible {
				background: color-mix(in srgb, var(--sb-danger) 10%, var(--sb-surface));
				border-color: var(--sb-danger);
				color: var(--sb-danger);
			}
			me [data-empty] {
				background: var(--sb-surface);
				border: 2px solid var(--sb-frame);
				padding: 2rem 1rem;
				text-align: center;
			}
			me [data-empty] h2 {
				font-size: 1.125rem;
				margin-bottom: 0.5rem;
			}
			me [data-empty] p {
				color: var(--sb-muted);
				margin: 0;
			}
			@media sm- {
				me h1 {
					font-size: 1.625rem;
				}
				me > ul > li {
					padding: 0.75rem;
				}
			}
			@media xs- {
				me {
					margin-block-start: -0.75rem;
				}
			}
		</style>
		<header>
			<h1 id="profiles-heading">Profiles</h1>
			<a class="btn btn-primary" href={ model.CreateHref } hx-get={ model.CreateHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
				@viewicons.Plus()
				<span>New profile</span>
			</a>
		</header>
		if len(model.Profiles) == 0 {
			<div data-empty>
				<h2>No profiles yet</h2>
				<p>Create a profile to get started.</p>
			</div>
		} else {
			<ul aria-label="Profiles">
				for _, profile := range model.Profiles {
					<li>
						<img data-profile-icon src={ AvatarHref(profile.Id) } alt="" width="40" height="40"/>
						<span data-profile-name>{ profile.Name }</span>
						if deleteHref := profile.Actions.Href("delete"); deleteHref != "" {
							<button
								class="btn btn-outline-secondary btn-sm"
								type="button"
								data-delete-profile
								aria-label={ "Delete " + profile.Name }
								hx-delete={ deleteHref }
								hx-target="#main"
								hx-swap="outerHTML"
								hx-disabled-elt="this"
							>
								@viewicons.Trash()
								<span>Delete</span>
							</button>
						}
					</li>
				}
			</ul>
		}
	</section>
}

package profiles

import (
	"strconv"

	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/profiles"
)

templ selectedProfile(model viewmodels.Navigation) {
	<div class="dropdown" data-profile-switcher>
		<style>
			me > button { background: transparent; border: 0; border-radius: 0; box-shadow: none; display: block; height: 40px; padding: 0; width: 40px; }
			me > button:hover > img, me > button[aria-expanded="true"] > img { border-color: var(--sb-accent); }
			me > button:focus-visible { outline: 2px solid var(--sb-accent); outline-offset: 2px; }
			me > button > img { border: 2px solid #000; border-radius: 0; box-sizing: border-box; display: block; height: 100%; object-fit: cover; width: 100%; }
			me > .dropdown-menu { background: var(--sb-surface); border: 1px solid var(--sb-frame); border-radius: 0; box-shadow: none; margin-top: 0.625rem; max-height: min(24rem, calc(100dvh - 6rem)); min-width: 0; overflow-y: auto; padding: 0.375rem; position: absolute; width: min(14rem, calc(100vw - 1.5rem)); }
			me .dropdown-item { align-items: center; border: 0; color: var(--sb-text); display: flex; gap: 0.75rem; min-height: 3.25rem; padding: 0.5rem; }
			me .dropdown-item:hover, me .dropdown-item:focus { background: var(--sb-hover); color: var(--sb-text); }
			me .dropdown-item:active { background: var(--sb-subtle); }
			me .dropdown-item > img { border: 1px solid var(--sb-border); flex: 0 0 2.25rem; height: 2.25rem; object-fit: cover; width: 2.25rem; }
			me .dropdown-item > span { flex: 1; font-size: 0.9375rem; font-weight: 650; min-width: 0; overflow-wrap: anywhere; text-align: left; white-space: normal; }
			me .dropdown-item > small { color: var(--sb-muted); flex-shrink: 0; font-size: 0.75rem; font-weight: 400; margin-left: auto; text-align: right; }
		</style>
		<button type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label={ "Switch profile: " + model.Profile.Name } title={ model.Profile.Name }>
			<img src={ profileAvatarHref(model.Profile.Id) } alt="" width="40" height="40"/>
		</button>
		<form class="dropdown-menu dropdown-menu-end" action="/profiles/selection" method="post" aria-label="Switch profile">
			for _, profile := range model.Profiles {
				<button
					type="submit"
					class="dropdown-item"
					name="profile_id"
					value={ strconv.Itoa(profile.Id) }
					if profile.Id == model.Profile.Id {
						aria-current="true"
					}
				>
					<img src={ profileAvatarHref(profile.Id) } alt="" width="36" height="36"/>
					<span>{ profile.Name }</span>
					if profile.Id == model.Profile.Id {
						<small>Current</small>
					}
				</button>
			}
		</form>
	</div>
}

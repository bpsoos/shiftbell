package profiles

import (
	viewmodels "github.com/bpsoos/shiftbell/internal/models/view/profiles"
	viewicons "github.com/bpsoos/shiftbell/internal/view/icons"
)

templ profileForm(model viewmodels.Form) {
	<section aria-labelledby="profile-form-heading">
		<style>
			me { margin-inline: auto; max-width: 34rem; }
			me > [data-back] { align-items: center; color: var(--sb-muted); display: inline-flex; font-size: 0.875rem; gap: 0.375rem; margin-bottom: 1.125rem; text-decoration: none; }
			me > [data-back]:hover, me > [data-back]:focus-visible { color: var(--sb-text); }
			me [data-panel] { background: var(--sb-surface); border: 2px solid var(--sb-frame); }
			me [data-panel] > header { background: var(--sb-subtle); border-bottom: 1px solid var(--sb-border); border-left: 3px solid var(--sb-accent); padding: 1.125rem 1.25rem; }
			me h1 { font-size: 1.5rem; letter-spacing: -0.025em; margin: 0; }
			me form { padding: 1.25rem; }
			me .form-label { font-size: 0.875rem; font-weight: 650; }
			me .form-control { background-color: var(--sb-input); border-color: var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-text); }
			me .form-control:focus { border-color: var(--sb-accent); box-shadow: none; }
			me .form-control:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 2px; }
			me .form-control.is-invalid { border-color: var(--sb-danger); }
			me .invalid-feedback { color: var(--sb-danger); display: block; }
			me [data-summary] { border: 1px solid var(--sb-danger); border-left-width: 3px; color: var(--sb-text); font-size: 0.875rem; margin-bottom: 1rem; padding: 0.75rem; }
			me [data-actions] { align-items: center; border-top: 1px solid var(--sb-border); display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; padding-top: 1rem; }
			@media sm- { me form { padding: 1rem; } me [data-panel] > header { padding: 1rem; } }
		</style>
		<a data-back href={ model.CancelHref } hx-get={ model.CancelHref } hx-target="#main" hx-swap="outerHTML" hx-push-url="true">
			@viewicons.ArrowLeft()
			<span>Profiles</span>
		</a>
		<div data-panel>
			<header>
				<h1 id="profile-form-heading">New profile</h1>
			</header>
			<form action={ model.ActionHref } method="post" hx-post={ model.ActionHref } hx-target="#main" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']">
				if model.SummaryError != "" {
					<div data-summary role="alert">{ model.SummaryError }</div>
				}
				<label class="form-label" for="profile-name">Display name</label>
				<input
					class={ "form-control", templ.KV("is-invalid", model.Name.Error != "") }
					type="text"
					id="profile-name"
					name="name"
					data-profile-name-input
					value={ model.Name.Value }
					autocomplete="nickname"
					autocapitalize="off"
					spellcheck="false"
					required
					autofocus
					if model.Name.Error != "" {
						aria-invalid="true"
						aria-describedby="profile-name-error"
					}
				/>
				if model.Name.Error != "" {
					<div class="invalid-feedback" id="profile-name-error" role="alert">{ model.Name.Error }</div>
				}
				<div data-actions>
					<button class="btn btn-primary" type="submit">Create profile</button>
				</div>
			</form>
		</div>
	</section>
}

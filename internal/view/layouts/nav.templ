package layouts

import viewicons "github.com/bpsoos/shiftbell/internal/view/icons"

templ nav(active string) {
	<nav class="navbar navbar-expand-sm" aria-label="Primary navigation">
		<style>
			me { background: var(--sb-surface); border-bottom: 1px solid var(--sb-border); padding-block: 0; }
			me .container-fluid { min-height: 4rem; }
			me .navbar-brand { align-items: center; color: var(--sb-accent); display: inline-flex; font-weight: 600; gap: 0.8125rem; letter-spacing: -0.025em; }
			me .navbar-brand:hover { color: var(--sb-accent-hover); }
			me .shiftbell-logo { flex: 0 0 auto; height: 1.5rem; width: 1.5rem; }
			me .navbar-nav { gap: 0.25rem; }
			me .nav-link { color: var(--sb-muted); font-weight: 600; padding: 0.75rem; position: relative; }
			me .nav-link:hover { color: var(--sb-text); }
			me .nav-link.active { color: var(--sb-accent); }
			me .nav-link.active::after { background: var(--sb-accent); bottom: 0.4rem; content: ""; height: 1px; left: 0.75rem; position: absolute; width: 1.25rem; }
			me [data-secondary] { font-size: 0.875rem; font-weight: 500; }
			me [data-secondary]:not(.active) { color: #bcc0c7; }
			me [data-secondary]:not(.active):hover { color: var(--sb-text); }
			me .navbar-toggler { border-color: var(--sb-border); color: var(--sb-muted); font-size: 1.125rem; height: 2.125rem; padding: 0.4375rem; width: 2.125rem; }
			me .navbar-toggler:hover { color: var(--sb-text); }
			me .navbar-toggler .phosphor-icon { display: block; }
			@media sm- {
				me .navbar-brand { min-height: 2.75rem; }
				me .shiftbell-logo { height: 2rem; width: 2rem; }
				me [data-wordmark] { display: none; }
				me .navbar-collapse { border-top: 1px solid var(--sb-border); }
				me .navbar-nav { padding-block: 0.25rem 0.5rem; }
				me .nav-link { padding: 0.5rem 0.75rem; }
				me .nav-link.active::after { bottom: 0.2rem; }
			}
		</style>
		<div class="container-fluid">
			<a
				class="navbar-brand"
				aria-label="ShiftBell home"
				hx-get="/chores"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
				href="/chores"
			>
				@logo()
				<span data-wordmark>ShiftBell</span>
			</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primary-navigation" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation">
				@viewicons.List()
				<span class="visually-hidden">Toggle navigation</span>
			</button>
			<div class="collapse navbar-collapse" id="primary-navigation">
				<ul class="navbar-nav">
					<li class="nav-item">
						<a
							if active == "chores" {
								class="nav-link active"
								aria-current="page"
							} else {
								class="nav-link"
							}
							data-shiftbell-nav="chores"
							hx-get="/chores"
							hx-target="#main"
							hx-swap="outerHTML"
							hx-push-url="true"
							href="/chores"
						>Chores</a>
					</li>
					<li class="nav-item">
						<a
							if active == "chore-templates" {
								class="nav-link active"
								aria-current="page"
							} else {
								class="nav-link"
							}
							data-secondary
							data-shiftbell-nav="chore-templates"
							hx-get="/chore-templates"
							hx-target="#main"
							hx-swap="outerHTML"
							hx-push-url="true"
							href="/chore-templates"
						>Templates</a>
					</li>
				</ul>
			</div>
		</div>
	</nav>
}

templ logo() {
	<svg class="shiftbell-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		<g transform="rotate(90 12 12)">
			<path d="M10 10m-6 0a6 6 0 1 0 12 0a6 6 0 1 0 -12 0"></path>
			<path d="M13.5 15h.5a2 2 0 0 1 2 2v1a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-1a2 2 0 0 1 2 -2h.5"></path>
			<path d="M16 17a5.698 5.698 0 0 0 4.467 -7.932l-.467 -1.068"></path>
			<path d="M10 10v.01"></path>
			<path d="M20 8m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
		</g>
	</svg>
}

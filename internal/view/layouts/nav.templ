package layouts

import viewicons "github.com/bpsoos/shiftbell/internal/view/icons"

templ nav(active string) {
	<nav class="navbar navbar-expand-md" aria-label="Primary navigation">
		<style>
			me { background: var(--sb-surface); border-bottom: 2px solid var(--sb-frame); padding-block: 0; }
			me .container-fluid { max-width: 64rem; min-height: 4rem; padding-inline: 1.25rem; }
			me .navbar-brand { align-items: center; color: var(--sb-text); display: inline-flex; font-weight: 750; gap: 0.6875rem; letter-spacing: -0.03em; }
			me .navbar-brand:hover { color: var(--sb-muted-strong); }
			me .shiftbell-logo { flex: 0 0 auto; height: 1.5rem; width: 1.5rem; }
			me .navbar-nav { gap: 0.125rem; }
			me .nav-link { color: var(--sb-muted); font-size: 0.9375rem; font-weight: 650; padding: 0.9rem 0.75rem; position: relative; }
			me .nav-link:hover { color: var(--sb-text); }
			me .nav-link.active { color: var(--sb-text); }
			me .nav-link.active::after { background: var(--sb-accent); bottom: 0.45rem; content: ""; height: 3px; left: 0.75rem; position: absolute; width: 1.5rem; }
			me .navbar-collapse { order: 2; }
			me [data-nav-actions] { align-items: center; display: flex; gap: 0.375rem; margin-left: auto; order: 3; }
			me [data-header-button] { align-items: center; background: transparent; border: 1px solid var(--sb-control-border); border-radius: var(--sb-radius-control); color: var(--sb-muted); font-size: 1.125rem; height: 2.25rem; justify-content: center; padding: 0.4375rem; width: 2.25rem; }
			me [data-theme-toggle] { display: inline-flex; }
			me [data-header-button]:hover { background: var(--sb-hover); border-color: var(--sb-frame); color: var(--sb-text); }
			me [data-header-button]:focus { box-shadow: none; }
			me [data-header-button]:focus-visible { box-shadow: none; outline: 2px solid var(--sb-focus); outline-offset: 2px; }
			me [data-header-button] .phosphor-icon { display: block; }
			me [data-theme-icon] { display: none; }
			[data-bs-theme="dark"] me [data-theme-icon="light"] { display: block; }
			[data-bs-theme="light"] me [data-theme-icon="dark"] { display: block; }
			@media sm- {
				me .container-fluid { padding-inline: 0.75rem; }
				me .navbar-brand { min-height: 3.5rem; }
				me .shiftbell-logo { height: 1.75rem; width: 1.75rem; }
				me [data-wordmark] { display: none; }
				me [data-nav-actions] { order: 2; }
				me .navbar-collapse { border-top: 1px solid var(--sb-border); order: 3; }
				me .navbar-nav { padding-block: 0.25rem 0.5rem; }
				me .nav-link { padding: 0.625rem 0.75rem; }
				me .nav-link.active::after { bottom: 0.2rem; }
			}
		</style>
		<div class="container-fluid">
			<a
				class="navbar-brand"
				aria-label="ShiftBell home"
				hx-get="/chores"
				hx-target="#main"
				hx-swap="outerHTML"
				hx-push-url="true"
				href="/chores"
			>
				@logo()
				<span data-wordmark>ShiftBell</span>
			</a>
			<div data-nav-actions>
				<button type="button" data-header-button data-theme-toggle aria-label="Toggle color theme">
					<span data-theme-icon="light">@viewicons.Sun()</span>
					<span data-theme-icon="dark">@viewicons.Moon()</span>
					<span class="visually-hidden" data-theme-label>Toggle color theme</span>
				</button>
				<button class="navbar-toggler" type="button" data-header-button data-bs-toggle="collapse" data-bs-target="#primary-navigation" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation">
					@viewicons.List()
					<span class="visually-hidden">Toggle navigation</span>
				</button>
			</div>
			<div class="collapse navbar-collapse" id="primary-navigation">
				<ul class="navbar-nav">
					<li class="nav-item">
						<a
							if active == "chores" {
								class="nav-link active"
								aria-current="page"
							} else {
								class="nav-link"
							}
							data-shiftbell-nav="chores"
							hx-get="/chores"
							hx-target="#main"
							hx-swap="outerHTML"
							hx-push-url="true"
							href="/chores"
						>Chores</a>
					</li>
					<li class="nav-item">
						<a
							if active == "chore-templates" {
								class="nav-link active"
								aria-current="page"
							} else {
								class="nav-link"
							}
							data-shiftbell-nav="chore-templates"
							hx-get="/chore-templates"
							hx-target="#main"
							hx-swap="outerHTML"
							hx-push-url="true"
							href="/chore-templates"
						>Templates</a>
					</li>
				</ul>
			</div>
		</div>
	</nav>
}

templ logo() {
	<svg class="shiftbell-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		<g transform="rotate(90 12 12)">
			<path d="M10 10m-6 0a6 6 0 1 0 12 0a6 6 0 1 0 -12 0"></path>
			<path d="M13.5 15h.5a2 2 0 0 1 2 2v1a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-1a2 2 0 0 1 2 -2h.5"></path>
			<path d="M16 17a5.698 5.698 0 0 0 4.467 -7.932l-.467 -1.068"></path>
			<path d="M10 10v.01"></path>
			<path d="M20 8m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
		</g>
	</svg>
}

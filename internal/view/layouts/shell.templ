package layouts

templ Frame(active string, fullPage bool, content templ.Component) {
	if fullPage {
		@page(active, content)
	} else {
		@main(content)
	}
}

templ page(active string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>ShiftBell</title>
			@dependencies()
		</head>
		<body>
			<style>
				me .shiftbell-skip-link { background: var(--sb-surface); border: 1px solid var(--sb-frame); border-radius: var(--sb-radius-overlay); box-shadow: 3px 3px 0 var(--sb-depth); color: var(--sb-text); left: 0.5rem; padding: 0.5rem 0.75rem; position: fixed; top: 0.5rem; transform: translateY(calc(-100% - 1rem)); z-index: 1100; }
				me .shiftbell-skip-link:focus { box-shadow: 3px 3px 0 var(--sb-depth); transform: translateY(0); }
				me #main { padding-bottom: 3.5rem; padding-top: 1.75rem; }
				me #main:focus:not(:focus-visible) { outline: none; }
				me #main.htmx-swapping { opacity: 0.45; }
				@media (prefers-reduced-motion: no-preference) {
					me .shiftbell-skip-link, me #main { transition: opacity 150ms ease, transform 150ms ease; }
				}
				@media xs- {
					me #main { padding-bottom: 2.5rem; padding-top: 1.25rem; }
				}
			</style>
			<a class="shiftbell-skip-link" href="#main">Skip to content</a>
			@nav(active)
			@main(content)
			<div id="dialog-root"></div>
		</body>
	</html>
}

templ main(content templ.Component) {
	<main id="main" class="container" tabindex="-1">
		@content
	</main>
}

templ dependencies() {
	<script src="/assets/shiftbell.js"></script>
	<link href="/assets/bootstrap.min.css" rel="stylesheet"/>
	<link href="/assets/shiftbell.css" rel="stylesheet"/>
	@cssScopeInline()
	<script defer src="/assets/bootstrap.bundle.min.js"></script>
	<script defer src="/assets/htmx.min.js"></script>
}

templ cssScopeInline() {
	<script>
		window.cssScopeCount ??= 1
		window.cssScope ??= new MutationObserver(() => {
			document?.body?.querySelectorAll('style:not([ready])').forEach(node => {
				var scope = 'me__' + window.cssScopeCount++
				node.parentNode.classList.add(scope)
				node.textContent = node.textContent
					.replace(/(?:^|\.|(\s|[^a-zA-Z0-9\-\_]))(me|this|self)(?![a-zA-Z\/])/g, '$1.' + scope)
					.replace(/((@keyframes|animation:|animation-name:)[^{};]*)\.me__/g, '$1me__')
					.replace(/(?:@media)\s(xs-|sm-|md-|lg-|xl-|sm|md|lg|xl|xx)/g, (match, breakpoint) => {
						return '@media ' + {
							sm: '(min-width: 640px)',
							md: '(min-width: 768px)',
							lg: '(min-width: 1024px)',
							xl: '(min-width: 1280px)',
							xx: '(min-width: 1536px)',
							'xs-': '(max-width: 639px)',
							'sm-': '(max-width: 767px)',
							'md-': '(max-width: 1023px)',
							'lg-': '(max-width: 1279px)',
							'xl-': '(max-width: 1535px)',
						}[breakpoint]
					})
				node.setAttribute('ready', '')
			})
		})
		window.cssScope.observe(document.documentElement, { childList: true, subtree: true })
	</script>
}
